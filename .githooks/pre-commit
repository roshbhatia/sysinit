#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

status=0

# The nix source rules. This used to be a flake check, which meant it ran only
# when someone remembered to run the flake. Here it runs on the staged files,
# so a violation is caught by the commit that introduces it.
if command -v ast-grep > /dev/null 2>&1; then
  staged_nix=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.nix$' || true)
  if [[ -n ${staged_nix} ]]; then
    # shellcheck disable=SC2086
    if ! (cd "$repo_root" && ast-grep scan -c sgconfig.yml $staged_nix); then
      echo "ast-grep: fix the source, or change the rule under .ast-grep/rules/" >&2
      status=1
    fi
  fi
fi

# One place owns each state path. Over the whole tree rather than the staged
# files, because a reader's fallback and the manifest key it falls back from
# usually move in separate commits, and the pair is what has to stay consistent.
# Needs only git, grep, and awk, so there is nothing to skip when absent.
if ! "$repo_root/hack/check-state-paths.sh"; then
  status=1
fi

# The harness registry and the neovim adapter list. The second stays hand-kept
# because that config must work without Nix, so agreement is checked rather than
# generated.
if ! "$repo_root/hack/check-harness-registry.sh"; then
  status=1
fi

command -v citelock > /dev/null 2>&1 || exit "$status"
while IFS= read -r lock; do
  [[ -z ${lock} ]] && continue
  dir="$(dirname "$lock")"
  if ! citelock verify "$dir"; then
    status=1
  fi
done < <(find "${repo_root}/openspec/changes" -name citations.lock 2> /dev/null)

if command -v spec-preflight > /dev/null 2>&1; then
  while IFS= read -r change; do
    [[ -z ${change} ]] && continue
    if ! spec-preflight all "$change"; then
      status=1
    fi
  done < <(
    git diff --cached --name-only --diff-filter=ACMR |
      sed -n 's|^openspec/changes/\([^/]*\)/.*|\1|p' |
      grep -v '^archive$' |
      sort -u
  )
fi

exit "$status"

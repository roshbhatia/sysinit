#!/usr/bin/env bash
# Offline citation gate. For each openspec change with a citations.lock, run
# the offline stages of citelock (format, provenance, quote-anchor, integrity,
# freshness). No network, no MCP tool: verify never fetches, so this is safe
# offline and needs no --no-verify. Live-web checks live in `citelock capture`,
# not here. A change with no citations.lock is a no-op.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
citelock="${repo_root}/hack/citelock.sh"
[[ -x ${citelock} ]] || exit 0

# Verify every change dir that ships a citations.lock (cheap; verify no-ops when
# a dir has none). Covers active changes and archived ones.
status=0
while IFS= read -r lock; do
  [[ -z ${lock} ]] && continue
  dir="$(dirname "$lock")"
  if ! "$citelock" verify "$dir"; then
    status=1
  fi
done < <(find "${repo_root}/openspec/changes" -name citations.lock 2> /dev/null)

exit "$status"

#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
command -v citelock > /dev/null 2>&1 || exit 0

status=0
while IFS= read -r lock; do
  [[ -z ${lock} ]] && continue
  dir="$(dirname "$lock")"
  if ! citelock verify "$dir"; then
    status=1
  fi
done < <(find "${repo_root}/openspec/changes" -name citations.lock 2> /dev/null)

if command -v spec-preflight > /dev/null 2>&1; then
  while IFS= read -r change; do
    [[ -z ${change} ]] && continue
    if ! spec-preflight all "$change"; then
      status=1
    fi
  done < <(
    git diff --cached --name-only --diff-filter=ACMR |
      sed -n 's|^openspec/changes/\([^/]*\)/.*|\1|p' |
      grep -v '^archive$' |
      sort -u
  )
fi

exit "$status"

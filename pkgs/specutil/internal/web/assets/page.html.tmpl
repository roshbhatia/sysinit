<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>specutil</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" integrity="sha384-vsrfeLOOY6KuIYKDlmVH5UiBmgIdB1oEf7p01YgWHuqmOHfZr374+odEv96n9tNC" crossorigin="anonymous" onerror="(window.__cdnFail=window.__cdnFail||[]).push('chart')"></script>
<script src="https://cdn.jsdelivr.net/npm/cytoscape@3.30.2/dist/cytoscape.min.js" integrity="sha384-IWROdLKRsN1UuJywMlWl7/blXQ8GEooN2n7dzTxfEPd7ybYIKCUJ2Ol/1Gpf3YV4" crossorigin="anonymous" onerror="(window.__cdnFail=window.__cdnFail||[]).push('cytoscape')"></script>
<style>
/* ================================================================
   SPECUTIL — clean professional theme
   ================================================================ */

:root {
  color-scheme: light;
  --bg:        #f3f4f6;
  --content:   #ffffff;
  --surface-2: #f9fafb;
  --surface-3: #f3f4f6;
  --ink:       #111827;
  --muted:     #6b7280;
  --line:      #e5e7eb;
  --line-dark: #d1d5db;

  --accent:    #4f46e5;
  --accent-on: #ffffff;

  --lc-proposed-bg:   #ede9fe; --lc-proposed-ink: #4338ca; --lc-proposed-line: #c4b5fd;
  --lc-active-bg:     #fef3c7; --lc-active-ink:   #92400e; --lc-active-line:   #fcd34d;
  --lc-archived-bg:   #d1fae5; --lc-archived-ink: #065f46; --lc-archived-line: #6ee7b7;

  --done:    #059669;
  --warn-bg: #fef3c7; --warn-line: #fcd34d; --warn-ink: #92400e;
  --err-bg:  #fee2e2; --err-line:  #fca5a5; --err-ink:  #991b1b;

  --font-ui:   -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Arial, sans-serif;
  --font-mono: "Monaco", "Menlo", ui-monospace, "SFMono-Regular", Consolas, monospace;

  --shadow-sm: 0 1px 2px rgba(0,0,0,.06);
  --shadow:    0 1px 3px rgba(0,0,0,.1), 0 1px 2px rgba(0,0,0,.06);
  /* keep legacy names so existing uses still compile */
  --hard-shadow:    var(--shadow);
  --hard-shadow-sm: var(--shadow-sm);
  --panel-head-bg:  #1f2937;
  --panel-head-fg:  #f9fafb;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { font-size: 16px; }
body {
  font-family: var(--font-ui); font-size: 13px; line-height: 1.5;
  color: var(--ink);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
}
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }
*:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
h1 { font-weight: 700; font-size: 1.1rem; letter-spacing: -.01em; }
h2 { font-weight: 700; font-size: .9375rem; margin: 1.1rem 0 .35rem; }
h3 { font-weight: 700; font-size: .875rem; margin: 0; }
h1:focus, h2:focus { outline: none; }
code {
  font-family: var(--font-mono); font-size: .8em;
  background: var(--surface-2); border: 1px solid var(--line);
  padding: .05em .3em; color: var(--ink);
}
.wrap { max-width: 76rem; margin: 0 auto; padding: 0 1.25rem 4rem; }
.tnum { font-variant-numeric: tabular-nums; font-family: var(--font-mono); }

/* ================================================================
   APP BAR
   ================================================================ */
.appbar {
  position: sticky; top: 0; z-index: 100;
  background: #111827;
  border-bottom: 1px solid #374151;
  padding: .4rem 1.25rem;
  margin-bottom: 1.25rem;
  display: flex; align-items: center; gap: 0;
}
.appbar .brand {
  font-weight: 700; font-size: 13px; color: #f9fafb;
  text-decoration: none; padding: 3px 12px 3px 0;
  border-right: 1px solid #374151; margin-right: .5rem;
}
.appbar .brand:hover { text-decoration: none; }
.tabs { display: flex; }
.tabs a {
  font-size: 12px; font-weight: 500;
  padding: 5px 14px; text-decoration: none;
  color: #9ca3af; background: transparent;
}
.tabs a:hover { color: #f9fafb; text-decoration: none; }
.tabs a.on { color: #f9fafb; border-bottom: 2px solid var(--accent); }

/* ================================================================
   BADGES / METERS / STATS
   ================================================================ */
.badge {
  display: inline-block; font-size: 9px; font-weight: 700;
  letter-spacing: .08em; text-transform: uppercase;
  padding: 1px 6px; border: 1px solid transparent; white-space: nowrap;
}
.badge.proposed { background: var(--lc-proposed-bg); color: var(--lc-proposed-ink); border-color: var(--lc-proposed-line); }
.badge.active   { background: var(--lc-active-bg);   color: var(--lc-active-ink);   border-color: var(--lc-active-line); }
.badge.archived { background: var(--lc-archived-bg); color: var(--lc-archived-ink); border-color: var(--lc-archived-line); }

.meter { height: 6px; background: var(--line); border-radius: 3px; overflow: hidden; }
.meter > span { display: block; height: 100%; background: var(--accent); border-radius: 3px; }
.metric { font-family: var(--font-mono); font-size: 11px; color: var(--muted); }

.tally { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: .85rem; }
.stat {
  background: var(--content); border: 1px solid var(--line); border-radius: 8px;
  box-shadow: var(--shadow-sm); padding: .5rem .85rem; min-width: 5rem;
}
.stat b { display: block; font-family: var(--font-mono); font-size: 1.4rem; font-weight: 700; line-height: 1.1; }
.stat span { display: block; font-size: 9px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-top: .15rem; }

/* ================================================================
   KANBAN BOARD
   ================================================================ */
.board { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; align-items: start; }
.board .col { background: var(--content); border: 1px solid var(--line); border-radius: 8px; box-shadow: var(--shadow-sm); overflow: hidden; }
.board .col-head {
  background: var(--surface-2);
  padding: 6px 12px; display: flex; justify-content: space-between; align-items: center;
  border-bottom: 1px solid var(--line);
}
.board .col-head .badge { }
.board .col-head .ct {
  font-family: var(--font-mono); font-size: 11px; font-weight: 600;
  color: var(--muted);
}
.board .col-body { padding: .5rem; }
.board .bcard {
  appearance: none; -webkit-appearance: none;
  display: block; width: 100%; text-align: left; font: inherit; cursor: pointer;
  background: var(--content); border: 1px solid var(--line); border-radius: 6px;
  box-shadow: var(--shadow-sm);
  padding: .6rem .75rem; margin-bottom: .4rem; transition: box-shadow .15s, border-color .15s;
}
.board .bcard:last-child { margin-bottom: 0; }
.board .bcard:hover { border-color: var(--accent); box-shadow: var(--shadow); }
.board .bcard h3 { font-size: .8125rem; line-height: 1.3; font-weight: 600; }
.board .bcard .sub { font-size: 11px; color: var(--muted); margin-top: .3rem; }
.board .bcard .meter { margin: .4rem 0 0; height: 3px; }
.board .empty-col { font-size: 11px; color: var(--muted); padding: .5rem .75rem; }
@media (max-width: 42rem) { .board { grid-template-columns: 1fr; } }

/* ================================================================
   GRAPH VIEW — Cytoscape container + inspector
   ================================================================ */
.graph-shell {
  display: grid; grid-template-columns: minmax(0, 1fr) 17rem;
  gap: .65rem; align-items: stretch;
}
.graph-workbench { min-width: 0; }
/* Height is set inline from the level model; this is the fallback. */
#cy-container {
  width: 100%; height: 420px; max-height: 68vh;
  border: 1px solid var(--line); border-radius: 8px; box-shadow: var(--shadow-sm);
  background: var(--surface-2);
}
.graph-inspector {
  background: var(--content); border: 1px solid var(--line);
  border-radius: 8px; box-shadow: var(--shadow-sm); overflow: hidden;
}
.graph-inspector-head {
  background: var(--surface-2); color: var(--muted);
  border-bottom: 1px solid var(--line); padding: 6px 10px;
  font-size: 11px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase;
}
.graph-inspector-head span { opacity: .65; font-weight: 400; }
.graph-inspector-body { padding: .65rem .75rem; overflow-y: auto; max-height: calc(100vh - 260px); }
.graph-empty { padding: 1.5rem; color: var(--muted); line-height: 1.6; }
.graph-toolbar { display: flex; align-items: center; gap: .65rem; flex-wrap: wrap; margin-bottom: .5rem; }
.graph-hint-text { font-size: 11px; color: var(--muted); }
.grain-switch {
  display: inline-flex; border: 1px solid var(--line); border-radius: 7px;
  overflow: hidden; flex-shrink: 0;
}
.grain-btn {
  font: inherit; font-size: 11px; font-weight: 600; color: var(--muted);
  background: var(--content); border: 0; padding: 4px 10px; cursor: pointer;
  display: flex; align-items: center; gap: .3rem;
}
.grain-btn + .grain-btn { border-left: 1px solid var(--line); }
.grain-btn.on { background: var(--surface-2); color: var(--ink); }
.grain-ct { font-size: 9px; font-weight: 400; opacity: .65; }

.graph-status-bar {
  display: flex; align-items: center; flex-wrap: wrap; gap: .5rem;
  margin: .4rem 0 .65rem;
}
.graph-status-chip {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 11px; font-weight: 500; color: var(--ink);
  background: var(--content); border: 1px solid var(--line); border-radius: 20px;
  padding: 2px 8px;
}
.gsc-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--chip-color, #9ca3af); flex-shrink: 0;
}

.graph-legend {
  display: flex; gap: .75rem; flex-wrap: wrap; margin-top: .4rem;
  font-size: 10px; color: var(--muted); align-items: center;
}
.legend-item { display: flex; align-items: center; gap: .3rem; }
.legend-line { display: inline-block; width: 24px; height: 0; vertical-align: middle; }
.legend-line.critical  { border-top: 3px solid #f59e0b; }
.legend-line.blocking  { border-top: 2px dashed #f97316; }
.legend-line.satisfied { border-top: 2px solid #86efac; }
.legend-line.suggested { border-top: 2px dotted #c7d2fe; }
.legend-line.declared  { border-top: 2px solid #a5b4fc; }
@media (max-width: 52rem) { .graph-shell { grid-template-columns: 1fr; } }

/* Lede — the answer before the picture: what is workable, how deep, what is
   on the critical path. */
.graph-lede {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  gap: .65rem; margin: .5rem 0 .7rem;
}
.lede-block {
  background: var(--content); border: 1px solid var(--line); border-radius: 8px;
  box-shadow: var(--shadow-sm); padding: .6rem .75rem;
}
.lede-num { font-size: 1.5rem; font-weight: 700; line-height: 1.1; margin-right: .35rem; }
.lede-label {
  font-size: 10px; font-weight: 600; letter-spacing: .06em;
  text-transform: uppercase; color: var(--muted);
}
.lede-note { font-size: 11px; color: var(--muted); margin: .35rem 0 0; line-height: 1.45; }
.lede-block .chips { margin-top: .4rem; }

/* Level roster — the canvas model as text, usable without a pointer. */
.level-roster {
  display: grid; grid-auto-flow: column; grid-auto-columns: minmax(13rem, 1fr);
  gap: .55rem; margin-top: .7rem; overflow-x: auto; padding-bottom: .3rem;
}
.level-col {
  background: var(--content); border: 1px solid var(--line);
  border-radius: 8px; box-shadow: var(--shadow-sm); overflow: hidden;
}
.level-head {
  display: flex; align-items: center; justify-content: space-between;
  background: var(--surface-2); border-bottom: 1px solid var(--line);
  padding: 5px 9px; font-size: 10px; font-weight: 700;
  letter-spacing: .06em; text-transform: uppercase; color: var(--muted);
}
.level-head .ct { font-weight: 400; opacity: .7; }
.level-body { padding: .4rem; display: flex; flex-direction: column; gap: .3rem; }
.level-item {
  display: grid; grid-template-columns: 8px 1fr; gap: .4rem .45rem;
  align-items: center; text-decoration: none; color: inherit;
  border: 1px solid var(--line); border-radius: 6px; padding: .35rem .45rem;
}
.level-item:hover { border-color: var(--accent, #4f46e5); background: var(--surface-2); }
.level-name {
  font-size: 11px; font-weight: 600; min-width: 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.level-meta { grid-column: 2; font-size: 10px; color: var(--muted); }
@media (max-width: 52rem) {
  .level-roster { grid-auto-flow: row; grid-auto-columns: auto; }
}

/* ================================================================
   SUGGESTED EDGES
   ================================================================ */
.suggest-panel { margin-top: .85rem; border: 1px solid var(--line); border-radius: 8px; box-shadow: var(--shadow-sm); overflow: hidden; }
.suggest-head {
  background: var(--surface-2); color: var(--muted); padding: 6px 10px;
  border-bottom: 1px solid var(--line);
  font-size: 11px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase;
}
.suggest-head span { opacity: .65; font-weight: 400; }
.suggest-body { background: var(--content); padding: .6rem .75rem; overflow-x: auto; }
.suggest-table { border-collapse: collapse; font-size: 11px; width: 100%; min-width: 34rem; }
.suggest-table th {
  font-size: 9px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
  color: var(--muted); text-align: left; padding: .3rem .5rem; border-bottom: 2px solid var(--ink);
}
.suggest-table td { padding: .35rem .5rem; border-bottom: 1px solid var(--surface-2); }
.suggest-table tr:last-child td { border-bottom: 0; }

/* ================================================================
   DETAIL — DRILLDOWN
   ================================================================ */
.doc { margin-top: .25rem; }
.doclayout { display: grid; grid-template-columns: 1fr 15rem; gap: 1.25rem; align-items: start; }
.doclayout .rail { position: sticky; top: .75rem; }
.rail .panel { background: var(--content); border: 1px solid var(--line); border-radius: 8px; box-shadow: var(--shadow-sm); overflow: hidden; margin-bottom: .65rem; }
.rail .panel-title {
  background: var(--surface-2); color: var(--muted);
  padding: 6px 10px; border-bottom: 1px solid var(--line);
}
.rail .panel-title-label {
  color: var(--muted); font-size: 11px; font-weight: 600;
  letter-spacing: .04em; text-transform: uppercase;
}
.rail .panel-body { padding: .6rem .75rem; }
@media (max-width: 52rem) { .doclayout { grid-template-columns: 1fr; } .doclayout .rail { position: static; } }

.progress-big { text-align: center; padding: .45rem 0 .2rem; }
.progress-big .num { font-family: var(--font-mono); font-size: 1.85rem; font-weight: 700; line-height: 1; }
.progress-big .label { font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-top: .15rem; }
.chartwrap { margin: .45rem 0; }

/* ================================================================
   NARRATIVE — collapsed by default (progressive disclosure)
   ================================================================ */
.narrative { margin: 0 0 1rem; display: flex; flex-direction: column; gap: .35rem; }
details.narrative-block { border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
summary.narrative-summary {
  background: var(--surface-2); color: var(--ink);
  padding: 5px 10px; cursor: pointer; list-style: none; user-select: none;
  display: flex; align-items: center; gap: .4rem; border-bottom: 0;
  font-size: 11px; font-weight: 600;
}
details.narrative-block[open] summary.narrative-summary { border-bottom: 1px solid var(--line); }
summary.narrative-summary::-webkit-details-marker { display: none; }
summary.narrative-summary::before { content: "+"; font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
details.narrative-block[open] summary.narrative-summary::before { content: "−"; }
.narrative-body { padding: .6rem .85rem; background: var(--content); font-size: 12px; line-height: 1.55; }
.narrative-body p { margin: .3rem 0; }
.narrative-body ul.md { margin: .25rem 0 .5rem; padding-left: 1.2rem; }
.narrative-body ul.md li { margin: .2rem 0; }

/* ================================================================
   STAGE FLOW (replaces dense task-pill pipeline)
   ================================================================ */
.stage-flow {
  display: flex; align-items: center; flex-wrap: wrap; gap: 3px;
  margin: .4rem 0 1rem;
}
.sf-pair {
  display: flex; align-items: center; gap: 3px;
  /* arrow stays with its stage — never orphans on a new line */
}
.stage-flow-item {
  display: flex; align-items: center; gap: 3px;
  background: var(--content); border: 1px solid var(--line); border-radius: 6px;
  padding: 3px 8px; font-size: 11px; font-weight: 500;
  cursor: default; max-width: 200px;
  transition: border-color .12s;
}
.stage-flow-item:hover { border-color: var(--accent); }
.stage-flow-item .sf-num { font-family: var(--font-mono); font-size: 10px; color: var(--muted); flex-shrink: 0; }
.stage-flow-item .sf-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; flex: 1; }
.stage-flow-item .sf-pct {
  font-family: var(--font-mono); font-size: 10px; font-weight: 600; flex-shrink: 0;
  margin-left: 2px; padding: 1px 4px; border-radius: 4px;
  background: var(--lc-archived-bg); color: var(--lc-archived-ink);
}
.stage-flow-item .sf-pct.partial { background: var(--lc-proposed-bg); color: var(--lc-proposed-ink); }
.stage-flow-item .sf-pct.empty   { background: var(--surface-3); color: var(--muted); }
.stage-flow-arrow { color: var(--muted); font-size: 11px; flex-shrink: 0; user-select: none; }

/* compact single-line strip for inspector panel */
.stage-flow-compact {
  display: flex; align-items: center; flex-wrap: wrap; gap: 2px;
  margin: .25rem 0;
}
.sfc-arrow { color: var(--line-dark); font-size: 10px; flex-shrink: 0; }
.sfc-pill {
  display: inline-flex; align-items: center; gap: 3px;
  background: var(--lc-archived-bg); border: 1px solid var(--lc-archived-line);
  border-radius: 4px; padding: 1px 5px; cursor: default;
}
.sfc-pill.partial { background: var(--lc-proposed-bg); border-color: var(--lc-proposed-line); }
.sfc-pill.empty   { background: var(--surface-3); border-color: var(--line); }
.sfc-n { font-family: var(--font-mono); font-size: 9px; color: var(--muted); font-weight: 700; }
.sfc-p { font-family: var(--font-mono); font-size: 9px; font-weight: 700; color: var(--ink); }

/* kept for inspector only */
.pipeline {
  display: flex; align-items: flex-start; gap: 0;
  margin: .5rem 0 .85rem; overflow-x: auto; padding-bottom: .25rem;
}
.pipe-stage { display: flex; flex-direction: column; flex: 1; min-width: 6.5rem; }
.pipe-arrow { display: flex; align-items: center; padding: 0 .3rem; color: var(--muted); font-size: 10px; flex-shrink: 0; margin-top: 1.3rem; }
.pipe-phase-head { font-family: var(--font-mono); font-size: 9px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--muted); padding: 0 0 .2rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pipe-tasks { display: flex; flex-direction: column; gap: 2px; }
.pipe-task { border: 1px solid var(--line); background: var(--content); padding: 2px 5px; font-family: var(--font-mono); font-size: 9px; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pipe-task.done { background: var(--surface-2); color: var(--muted); text-decoration: line-through; }
.pipe-key { font-weight: 700; margin-right: .25rem; }
.pipe-bar { height: 3px; background: var(--line); margin-top: .3rem; overflow: hidden; }
.pipe-bar > span { display: block; height: 100%; background: var(--accent); }

/* ================================================================
   TASK ROWS — Linear/Jira style
   ================================================================ */
.task-list { border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
.task-row {
  display: grid; grid-template-columns: 22px 36px 1fr auto;
  align-items: center; gap: 0;
  padding: 5px 8px; border-bottom: 1px solid var(--surface-3); font-size: 12px;
}
.task-row:last-child { border-bottom: 0; }
/* ------------------------------------------------------------------ task cards */
.task-card {
  display: flex; gap: .5rem;
  padding: .45rem .6rem; margin: .3rem 0;
  border: 1px solid var(--line); border-radius: 6px;
  background: var(--content); transition: border-color .1s;
}
.task-card:hover { border-color: var(--line-dark); }
.task-card.done { opacity: .6; }
.tc-status {
  display: flex; flex-direction: column; align-items: center;
  gap: .15rem; flex-shrink: 0; padding-top: .1rem; min-width: 1.8rem;
}
.tc-check { font-size: 14px; color: var(--line-dark); line-height: 1; }
.tc-check.done { color: var(--done); }
.marker-list {
  display: grid; grid-template-columns: auto 1fr; gap: .15rem .5rem;
  margin: 0 0 .5rem; padding: .4rem .55rem;
  background: var(--surface-2); border-radius: 6px;
  font-size: 11px; line-height: 1.45;
}
.marker-list dt { color: var(--muted); font-weight: 600; white-space: nowrap; }
.marker-list dd { margin: 0; min-width: 0; }
.tc-waits { font-size: 10px; color: var(--muted); margin-top: .2rem; }
.dep {
  display: inline-block; font-family: var(--font-mono); font-size: 9px;
  border: 1px solid var(--line); border-radius: 4px; padding: 0 4px; margin-right: 3px;
}
.dep-done { color: #16a34a; border-color: #86efac; }
.dep-missing { color: #b45309; border-color: #fcd34d; }
.tc-key {
  font-family: var(--font-mono); font-size: 9px; font-weight: 700;
  color: var(--muted); text-align: center;
}
.tc-body { flex: 1; min-width: 0; }
.tc-title {
  font-size: 12.5px; line-height: 1.55; word-break: break-word;
  color: var(--ink);
}
.task-card.done .tc-title { color: var(--muted); text-decoration: line-through; text-decoration-thickness: 1px; }
.tc-chips { display: flex; flex-wrap: wrap; gap: .25rem; margin-top: .3rem; }
/* task tags: bracket-extracted labels */
.task-tag {
  font-size: 9.5px; font-family: var(--font-mono); font-weight: 700;
  letter-spacing: .04em; padding: 1px 5px; border-radius: 3px;
  border: 1px solid transparent; text-transform: uppercase;
}
.task-tag.tag-blocker { background: #fef2f2; color: #dc2626; border-color: #fecaca; }
.task-tag.tag-done    { background: var(--lc-archived-bg); color: var(--lc-archived-ink); border-color: var(--lc-archived-line); }
.task-tag.tag-cat     { background: var(--lc-proposed-bg); color: var(--lc-proposed-ink); border-color: var(--lc-proposed-line); }
/* inline ticket refs extracted from task text */
.task-ref {
  font-family: var(--font-mono); font-size: 9.5px; font-weight: 700;
  padding: 1px 5px; border-radius: 3px;
  background: var(--surface-3); border: 1px solid var(--line); color: var(--muted);
}

/* legacy task list kept for inspector only */
ul.tasks { list-style: none; padding: 0; margin: .2rem 0 0; }
ul.tasks li {
  display: flex; gap: .4rem; align-items: baseline;
  padding: .4rem .5rem; border-bottom: 1px solid var(--surface-2);
  font-size: 12px; line-height: 1.4;
}
ul.tasks li:last-child { border-bottom: 0; }
ul.tasks li.done .txt { color: var(--muted); text-decoration: line-through; text-decoration-thickness: 1px; }
.key {
  flex: 0 0 auto; min-width: 2.4rem; text-align: center;
  font-family: var(--font-mono); font-size: 10px; font-weight: 700;
  background: var(--surface-2); color: var(--muted);
  border: 1px solid var(--line); padding: .1rem .3rem;
}
.glyph { flex: 0 0 auto; width: 1rem; text-align: center; font-size: 12px; line-height: 1.3; }
.glyph.done { color: var(--done); }
.glyph.todo { color: var(--line); }
.txt { flex: 1; }
.kind {
  flex: 0 0 auto; font-size: 9px; font-weight: 700;
  letter-spacing: .06em; text-transform: uppercase;
  padding: 1px 4px; border: 1px solid transparent;
}
.kind.verify  { background: var(--lc-proposed-bg); color: var(--lc-proposed-ink); border-color: var(--lc-proposed-line); }
.kind.apply   { background: var(--lc-active-bg);   color: var(--lc-active-ink);   border-color: var(--lc-active-line); }
.kind.confirm { background: var(--lc-archived-bg); color: var(--lc-archived-ink); border-color: var(--lc-archived-line); }
.ext-ref {
  flex: 0 0 auto; font-family: var(--font-mono); font-size: 9px; font-weight: 700;
  letter-spacing: .04em; padding: 1px 5px;
  background: var(--surface-3); border: 1px solid var(--line); color: var(--muted);
}
.phase-block { margin-top: .65rem; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
.phase-block > summary { cursor: pointer; list-style: none; }
.phase-block > summary::-webkit-details-marker { display: none; }
.phase-h {
  display: flex; align-items: center;
  gap: .5rem; padding: 6px 10px;
  background: var(--surface-2); border-bottom: 1px solid transparent;
}
.phase-block[open] > summary .phase-h { border-bottom-color: var(--line); }
.phase-h::before { content: "+"; font-family: var(--font-mono); font-size: 12px; color: var(--muted); flex-shrink: 0; }
.phase-block[open] .phase-h::before { content: "−"; }
.phase-h h2 { margin: 0; font-size: .875rem; flex: 1; }
.phase-h .ct { font-family: var(--font-mono); font-size: 11px; color: var(--muted); flex-shrink: 0; margin-left: auto; }
.phase-block.has-open > summary .phase-h { border-left: 3px solid var(--accent); padding-left: 7px; background: #eef2ff; }
.phase-open-badge {
  font-family: var(--font-mono); font-size: 9px; font-weight: 700; padding: 1px 4px;
  background: var(--lc-proposed-bg); color: var(--lc-proposed-ink); border: 1px solid var(--lc-proposed-line);
  margin-left: .3rem;
}

/* ================================================================
   EYEBROW / CHIPS / MISC
   ================================================================ */
.eyebrow {
  font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  color: var(--muted); margin: .85rem 0 .35rem; padding-bottom: .2rem;
  border-bottom: 1px solid var(--line);
}
.eyebrow:first-child { margin-top: 0; }
.chips { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .35rem; }
.chip {
  display: inline-block; font-size: 11px; font-weight: 600;
  padding: 2px 8px; border: 1px solid var(--line); border-radius: 4px;
  text-decoration: none; color: var(--accent); background: var(--content);
  transition: border-color .12s, background .12s;
}
.chip:hover { background: var(--surface-2); border-color: var(--accent); text-decoration: none; }
.none { font-size: 11px; color: var(--muted); margin: .25rem 0 0; }

.btn {
  display: inline-flex; align-items: center; gap: .35rem;
  font-size: 12px; font-weight: 600;
  min-height: 28px; padding: 4px 12px;
  background: var(--accent); color: var(--accent-on);
  border: 1px solid var(--accent); border-radius: 6px;
  cursor: pointer; text-decoration: none; white-space: nowrap;
  transition: opacity .12s;
}
.btn:hover { opacity: .88; text-decoration: none; }
.btn:active { opacity: .76; }
.btn.btn-ghost {
  background: var(--content); color: var(--ink);
  border-color: var(--line-dark);
}
.btn.btn-ghost:hover { background: var(--surface-2); opacity: 1; }

.back {
  display: inline-flex; align-items: center; gap: .3rem;
  font-size: 12px; font-weight: 500; margin-bottom: .65rem;
  color: var(--muted); text-decoration: none;
  padding: 2px 0;
}
.back:hover { color: var(--ink); text-decoration: none; }
.doc p { line-height: 1.6; margin: .4rem 0; font-size: 12px; }
.doc ul.md { margin: .25rem 0 .6rem; padding-left: 1.2rem; }
.doc ul.md li { margin: .2rem 0; line-height: 1.5; font-size: 12px; }

#offline-note {
  background: var(--warn-bg); border: 1px solid var(--warn-line);
  color: var(--warn-ink); padding: .45rem .75rem; font-size: 11px; margin-bottom: .65rem;
}
#diag-banner {
  background: var(--err-bg); border: 1px solid var(--err-line);
  color: var(--err-ink); padding: .45rem .75rem; font-size: 11px; margin-bottom: .65rem;
}
#diag-banner b { font-weight: 700; }
#diag-banner ul { margin: .25rem 0 0; padding-left: 1.1rem; }
.empty { color: var(--muted); max-width: 36rem; line-height: 1.6; font-size: 12px; }

/* ---- review + annotation ---- */
.drift {
  display: inline-block; font-family: var(--font-mono); font-size: 9px;
  text-transform: uppercase; letter-spacing: .04em; padding: 0 .3rem;
  border-radius: 2px; margin-left: .3rem; vertical-align: middle;
}
.drift.new     { background: var(--lc-proposed-bg); color: var(--lc-proposed-ink); border: 1px solid var(--lc-proposed-line); }
.drift.changed { background: var(--warn-bg);        color: var(--warn-ink);        border: 1px solid var(--warn-line); }
.task-card.flagged { box-shadow: inset 2px 0 0 var(--err-line); }

/* ---- diff ---- */
.diff-file { border: 1px solid var(--line); margin-bottom: .5rem; background: var(--content); }
.diff-file > summary {
  cursor: pointer; padding: .35rem .5rem; font-family: var(--font-mono); font-size: 11px;
  background: var(--surface-2); display: flex; align-items: center; gap: .4rem;
}
.diff-file > summary .status {
  font-size: 9px; text-transform: uppercase; letter-spacing: .04em;
  padding: 0 .3rem; border: 1px solid var(--line-dark); color: var(--muted);
}
.diff-file > summary .counts { margin-left: auto; font-size: 10px; color: var(--muted); }
.hunk { border-top: 1px solid var(--line); padding: .35rem .5rem; }
.hunk-head { font-family: var(--font-mono); font-size: 10px; color: var(--muted); margin-bottom: .2rem; }
.diff-lines {
  font-family: var(--font-mono); font-size: 11px; line-height: 1.45;
  white-space: pre; overflow-x: auto; margin: 0;
}
.diff-lines .l { display: block; padding: 0 .3rem; }
.diff-lines .l.add { background: #e7f6ec; color: #05603a; }
.diff-lines .l.delete { background: #fdeceb; color: #a4262c; }
.diff-lines .l.context { color: var(--muted); }
.diff-empty { font-size: 11px; color: var(--muted); }

details.ann { margin-top: .3rem; }
details.ann > summary {
  cursor: pointer; font-size: 10px; color: var(--muted); list-style: none;
  font-family: var(--font-mono); text-transform: uppercase; letter-spacing: .04em;
}
details.ann > summary::-webkit-details-marker { display: none; }
details.ann > summary:hover { color: var(--accent); }
details.ann > summary .has-note { color: var(--accent); font-weight: 700; }
.ann-input {
  display: block; width: 100%; margin-top: .3rem; padding: .35rem .45rem;
  font-family: var(--font-ui); font-size: 11px; line-height: 1.5;
  border: 1px solid var(--line-dark); background: var(--content); color: var(--ink);
  border-radius: 3px; resize: vertical; box-sizing: border-box;
}
.ann-input:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
.ann-drop {
  display: inline-flex; align-items: center; gap: .3rem; margin-top: .25rem;
  font-size: 10px; color: var(--muted); cursor: pointer;
}

.review-decision { display: flex; flex-direction: column; gap: .25rem; margin-bottom: .5rem; }
.review-decision label {
  display: flex; align-items: center; gap: .35rem; font-size: 11px; cursor: pointer;
}
.review-actions { display: flex; gap: .35rem; flex-wrap: wrap; margin-top: .5rem; }
.review-actions button {
  font-family: var(--font-ui); font-size: 11px; padding: .3rem .6rem;
  border: 1px solid var(--line-dark); background: var(--surface-2); color: var(--ink);
  border-radius: 3px; cursor: pointer;
}
.review-actions button.primary { background: var(--accent); color: var(--accent-on); border-color: var(--accent); }
.review-actions button:hover { border-color: var(--accent); }
.review-hint {
  margin-top: .5rem; font-size: 10px; line-height: 1.6; color: var(--muted);
}
.review-hint code { font-size: 10px; }
#ann-count { font-family: var(--font-mono); }
.review-standing {
  font-size: 11px; line-height: 1.6; margin-bottom: .5rem;
  padding: .35rem .5rem; background: var(--surface-2); border: 1px solid var(--line);
}
.review-standing.stale { background: var(--warn-bg); border-color: var(--warn-line); color: var(--warn-ink); }

.sr-only {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { transition: none !important; transform: none !important; }
}
</style>
</head>
<body>
<header class="appbar">
  <a class="brand" href="#/">&#9672; specutil</a>
  <nav class="tabs" id="nav-tabs"></nav>
</header>
<div class="wrap">
  <div id="diag-banner" hidden></div>
  <div id="offline-note" hidden>CDN assets failed to load. Task content may be limited.</div>
  <div id="live" class="sr-only" aria-live="polite"></div>
  <main id="view"></main>
  <noscript><p style="margin-top:2rem;color:var(--muted);font-size:12px">This visualizer requires JavaScript.</p></noscript>
</div>

<script>
const GRAPH = {{.GraphJSON}};
const DETAIL = {{.DetailJSON}};
const DIAG = {{.DiagJSON}};
const SUGGEST = {{.SuggestJSON}};
</script>

<script>
(function () {
  const changes    = (DETAIL && DETAIL.changes) || [];
  const graphNodes = (GRAPH  && GRAPH.nodes)   || [];
  const edges      = (GRAPH  && GRAPH.edges)   || [];
  const diags      = DIAG || [];
  const candidates = SUGGEST || [];
  const byName     = new Map(changes.map((c) => [c.name, c]));

  const view = document.getElementById("view");
  const live = document.getElementById("live");
  let currentRoute = "/";
  let cyInstance = null;

  /* ---- minimal markdown ---- */
  const esc = (s) => String(s == null ? "" : s)
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  const inline = (s) => s
    .replace(/`([^`]+)`/g,      (_, c) => "<code>" + c + "</code>")
    .replace(/\*\*([^*]+)\*\*/g,(_, c) => "<strong>" + c + "</strong>")
    .replace(/\*([^*]+)\*/g,    (_, c) => "<em>" + c + "</em>");
  function md(src) {
    const lines = String(src || "").split(/\r?\n/);
    let html = "", inList = false, para = [];
    const flush = () => { if (para.length) { html += "<p>" + inline(esc(para.join(" "))) + "</p>"; para = []; } };
    const close = () => { if (inList) { html += "</ul>"; inList = false; } };
    for (const raw of lines) {
      const ln = raw.replace(/\s+$/, "");
      const hm = ln.match(/^#{1,6}\s+(.+)/);
      if (hm) { flush(); close(); html += '<p><strong>' + inline(esc(hm[1])) + '</strong></p>'; continue; }
      const li = ln.match(/^\s*[-*]\s+(.*)$/);
      if (li) { flush(); if (!inList) { html += '<ul class="md">'; inList = true; } html += "<li>" + inline(esc(li[1])) + "</li>"; continue; }
      if (!ln.trim()) { flush(); close(); continue; }
      close(); para.push(ln.trim());
    }
    flush(); close();
    return html;
  }

  /* ================================================================
     ANNOTATION STATE

     A reviewer's comments live only in this page's memory until they are
     exported. There is no server to post them to and no storage to persist
     them in: the page is a file on disk, and the return path is the JSON the
     reviewer copies or downloads, which `specutil review ingest` folds into
     the change's review record.

     Keys are the task identity emitted in the detail feed, not a position, so
     a comment written against task 3.2 still lands on the same task after the
     author renumbers it.
     ================================================================ */
  const FEEDBACK_SCHEMA = "specutil.review/v1";
  const notes    = new Map();  /* change \x00 identity -> {comment, action} */
  const verdicts = new Map();  /* change -> {decision, note} */

  const annKey = (change, identity) => change + "\x00" + identity;

  /* Seed from the record already on disk so a second pass edits the standing
     feedback instead of silently discarding it on the next export. The feed's
     notes map covers tasks and diff hunks alike. */
  changes.forEach((c) => {
    Object.entries(c.notes || {}).forEach(([identity, n]) => {
      notes.set(annKey(c.name, identity), {
        comment: n.comment || "",
        action:  n.action  || "comment",
      });
    });
    if (c.review) verdicts.set(c.name, { decision: c.review.decision || "", note: c.review.note || "" });
  });

  function getNote(change, identity) {
    return notes.get(annKey(change, identity)) || { comment: "", action: "comment" };
  }
  function setNote(change, identity, patch) {
    const key = annKey(change, identity);
    const cur = notes.get(key) || { comment: "", action: "comment" };
    const next = { ...cur, ...patch };
    if (!next.comment.trim() && next.action !== "drop") notes.delete(key);
    else notes.set(key, next);
  }
  function getVerdict(change) {
    return verdicts.get(change) || { decision: "", note: "" };
  }
  function annCount(change) {
    let n = 0;
    notes.forEach((v, k) => { if (k.startsWith(change + "\x00")) n++; });
    return n;
  }

  /* buildFeedback assembles the export document. The phase, file, and text ride
     along so a human reading the JSON can tell what a comment is about without
     resolving hashes, but identity is what the ingest side matches on. */
  function buildFeedback(name) {
    const c = byName.get(name) || { phases: [] };
    const v = getVerdict(name);
    const annotations = [];
    (c.phases || []).forEach((p) => (p.items || []).forEach((it) => {
      if (!it.identity) return;
      const n = notes.get(annKey(name, it.identity));
      if (!n) return;
      annotations.push({
        scope: "task",
        phase: p.name,
        identity: it.identity,
        text: it.text,
        action: n.action || "comment",
        comment: n.comment || "",
      });
    }));
    ((c.diff && c.diff.files) || []).forEach((f) => (f.hunks || []).forEach((h) => {
      const n = notes.get(annKey(name, h.identity));
      if (!n) return;
      annotations.push({
        scope: "hunk",
        file: f.path,
        identity: h.identity,
        text: h.header,
        action: n.action || "comment",
        comment: n.comment || "",
      });
    }));
    return {
      schema: FEEDBACK_SCHEMA,
      change: name,
      decision: v.decision || "commented",
      note: v.note || "",
      annotations,
    };
  }
  const feedbackJSON = (name) => JSON.stringify(buildFeedback(name), null, 2);

  function flash(msg) {
    const el = document.getElementById("review-flash");
    if (el) el.textContent = msg;
    if (live) live.textContent = msg;
  }

  /* copyText prefers the async clipboard API and falls back to a hidden
     textarea, because a page opened over file:// is not a secure context in
     every browser and the async API is unavailable there. */
  function copyText(text, okMsg) {
    const fallback = () => {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.position = "fixed"; ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try { ok = document.execCommand("copy"); } catch (e) { ok = false; }
      document.body.removeChild(ta);
      flash(ok ? okMsg : "Copy failed. Use Download instead.");
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(() => flash(okMsg), fallback);
      return;
    }
    fallback();
  }

  /* downloadJSON writes the export through an object URL. It is a local blob,
     so nothing leaves the machine. */
  function downloadJSON(name) {
    const blob = new Blob([feedbackJSON(name)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "specutil-feedback-" + name + ".json";
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(url), 0);
    flash("Downloaded specutil-feedback-" + name + ".json");
  }

  /* ---- helpers ---- */
  function progressOf(c) {
    const items = (c.phases || []).flatMap((p) => p.items || []);
    const total = items.length || Number(c.total || 0);
    const done  = items.length ? items.filter((i) => i.done).length : Number(c.done || 0);
    return { done, total, pct: total ? Math.round((done / total) * 100) : 0, hasTasks: total > 0 };
  }
  const progressLabel = (c) => {
    const p = progressOf(c);
    return p.hasTasks ? p.done + "/" + p.total + " tasks · " + p.pct + "%" : "No tasks";
  };
  const dependsOn = (n) => edges.filter((e) => e.to   === n).map((e) => e.from).sort();
  const blocks    = (n) => edges.filter((e) => e.from === n).map((e) => e.to).sort();
  const chipLink  = (n) => byName.has(n)
    ? '<a class="chip" href="#/c/' + encodeURIComponent(n) + '">' + esc(n) + "</a>"
    : '<span class="chip">' + esc(n) + "</span>";

  const LIFECYCLES = ["proposed", "active", "archived"];
  const feedIssues = (() => {
    const gids = new Set(graphNodes.map((n) => n.id));
    const dids = new Set(changes.map((c) => c.name));
    const out = [];
    gids.forEach((id) => { if (!dids.has(id)) out.push({ kind: "feed", msg: "Graph node has no detail entry: " + id }); });
    dids.forEach((id) => { if (gids.size && !gids.has(id)) out.push({ kind: "feed", msg: "Detail entry absent from graph: " + id }); });
    return out;
  })();

  const edgeKey = (e) => e.from + "\x00" + e.to;
  function novelCandidateGroups() {
    const confirmed = new Set(edges.map(edgeKey));
    const groups = new Map();
    candidates.forEach((c) => {
      if (confirmed.has(edgeKey(c))) return;
      const g = groups.get(edgeKey(c)) || { from: c.from, to: c.to, capabilities: [] };
      g.capabilities.push(c.capability);
      groups.set(edgeKey(c), g);
    });
    return Array.from(groups.values()).map((g) => ({ ...g, capabilities: [...new Set(g.capabilities)].sort() }))
      .sort((a, b) => a.from.localeCompare(b.from) || a.to.localeCompare(b.to));
  }
  function manifestSnippet(c) {
    return "changes:\n  " + JSON.stringify(c.to) + ":\n    depends_on:\n      - " + JSON.stringify(c.from);
  }
  function firstRemaining(c) {
    for (const p of (c.phases || [])) for (const it of (p.items || [])) if (!it.done) return plainText(it.text);
    return progressOf(c).hasTasks ? "All complete" : "No tasks";
  }
  function kindTag(it) {
    const k = it.kind; if (!k || k === "task") return "";
    return '<span class="kind ' + esc(k) + '">' + esc(k) + "</span>";
  }
  // A ticket id is only useful if it takes you to the ticket, so a recognised
  // id becomes a link and anything else stays copyable text.
  function refLink(id, cls, title) {
    if (/^https?:\/\//.test(id)) {
      const short = id.replace(/^https?:\/\/[^/]+\//, "").slice(0, 32) || id;
      return '<a class="' + cls + '" href="' + esc(id) + '" target="_blank" rel="noopener" title="' + esc(title || id) + '">' + esc(short) + "</a>";
    }
    if (/^[A-Z]{2,10}-\d+$/.test(id)) {
      return '<a class="' + cls + '" href="https://linear.app/search?q=' + encodeURIComponent(id) +
        '" target="_blank" rel="noopener" title="Open in Linear">' + esc(id) + "</a>";
    }
    return '<span class="' + cls + '" title="' + esc(title || id) + '">' + esc(id) + "</span>";
  }
  function extRefChips(it) {
    return (it.externalRefs || []).map((r) => refLink(r.externalId || "", "ext-ref", r.target)).join("");
  }
  function tagChips(it) {
    return (it.tags || []).map((t) => {
      const up = t.toUpperCase();
      const cls = up === "BLOCKER" || up === "URGENT" ? "tag-blocker"
                : up === "DONE" ? "tag-done"
                : "tag-cat";
      return '<span class="task-tag ' + cls + '">' + esc(t) + '</span>';
    }).join("");
  }
  function inlineRefChips(it) {
    return (it.inlineRefs || []).map((r) => refLink(r, "task-ref")).join("");
  }
  // plainText strips markdown markers for use in title attributes
  function plainText(s) {
    return s.replace(/\*\*([^*]+)\*\*/g, "$1").replace(/\*([^*]+)\*/g, "$1").replace(/`([^`]+)`/g, "$1");
  }
  function destroyChart() { if (window.__chart) { window.__chart.destroy(); window.__chart = null; } }
  function destroyCy() {
    if (cyInstance) {
      cyInstance.destroy();
      cyInstance = null;
    }
  }

  /* ---- stage flow — compact breadcrumb-style overview ---- */
  function stageFlowHTML(c, opts) {
    const phases = c.phases || [];
    if (!phases.length) return "";
    const compact = opts && opts.compact;
    if (compact) {
      /* inspector compact: single-line pill strip — number + % only, no stage name */
      let h = '<div class="stage-flow-compact">';
      phases.forEach((p, pi) => {
        const items = p.items || [];
        const d = items.filter((i) => i.done).length;
        const pct = items.length ? Math.round((d / items.length) * 100) : 0;
        const pctClass = pct === 100 ? "" : pct > 0 ? " partial" : " empty";
        if (pi > 0) h += '<span class="sfc-arrow">&#8594;</span>';
        h += '<span class="sfc-pill' + pctClass + '" title="Stage ' + esc(p.number) + ': ' + esc(p.name) + '">' +
          '<span class="sfc-n">' + esc(p.number) + '</span>' +
          '<span class="sfc-p">' + pct + '%</span>' +
          '</span>';
      });
      h += '</div>';
      return h;
    }
    let h = '<div class="stage-flow">';
    phases.forEach((p, pi) => {
      const items = p.items || [];
      const d = items.filter((i) => i.done).length;
      const pct = items.length ? Math.round((d / items.length) * 100) : 0;
      const pctClass = pct === 100 ? "" : pct > 0 ? " partial" : " empty";
      /* wrap arrow+item together so they never split across lines */
      if (pi > 0) {
        h += '<div class="sf-pair"><span class="stage-flow-arrow">&#8594;</span>';
      } else {
        h += '<div class="sf-pair">';
      }
      h += '<div class="stage-flow-item">' +
        '<span class="sf-num">' + esc(p.number) + '</span>' +
        '<span class="sf-name">' + esc(p.name) + '</span>' +
        '<span class="sf-pct' + pctClass + '">' + pct + '%</span>' +
        '</div></div>';
    });
    h += '</div>';
    return h;
  }

  /* ---- task pipeline HTML (inspector/graph hover only) ---- */
  /* ================================================================
     WORK GRAPH — status computation
     Answers: what can I work on now? what's blocked? what's done?
     ================================================================ */

  /* changeStatus returns one of: "done" | "blocked" | "in-progress" | "ready" | "waiting" */
  function changeStatus(c) {
    if (!c) return "waiting";
    const lifecycle = c.lifecycle || "proposed";
    if (lifecycle === "archived") return "done";
    const deps = dependsOn(c.name);
    const allDepsDone = deps.every((d) => { const dc = byName.get(d); return dc && dc.lifecycle === "archived"; });
    if (lifecycle === "active") return allDepsDone ? "in-progress" : "blocked";
    /* proposed */
    return allDepsDone ? "ready" : "waiting";
  }

  /* edgeStatus: is this dependency satisfied or still blocking? */
  function edgeStatus(fromId) {
    const fc = byName.get(fromId);
    if (fc && fc.lifecycle === "archived") return "satisfied";
    return "blocking";
  }

  /* inspector HTML — work-graph aware */
  function inspectorHTML(id) {
    const c = byName.get(id);
    if (!c) return '<p class="empty" style="margin-top:0">No detail entry for <code>' + esc(id) + '</code>.</p>';
    const p   = progressOf(c);
    const dep = dependsOn(id), blks = blocks(id);
    const st  = changeStatus(c);
    const statusLabel = { done: "Done", blocked: "Blocked", "in-progress": "In progress", ready: "Ready to start", waiting: "Waiting" };
    const statusClass = { done: "archived", blocked: "active", "in-progress": "active", ready: "proposed", waiting: "proposed" };

    /* blocked-by: upstream deps that are not yet done */
    const blockedBy = dep.filter((d) => { const dc = byName.get(d); return !dc || dc.lifecycle !== "archived"; });
    /* unlocks: downstream changes that would become ready if this finishes */
    const unlocks   = blks.filter((b) => {
      const bc  = byName.get(b); if (!bc) return false;
      const bDeps = dependsOn(b).filter((d) => d !== id);
      return bDeps.every((d) => { const dc = byName.get(d); return dc && dc.lifecycle === "archived"; });
    });

    const nextTask = firstRemaining(c);

    let h = '<div style="display:flex;align-items:baseline;gap:.4rem;flex-wrap:wrap;margin-bottom:.4rem">' +
      '<strong>' + esc(c.name) + '</strong>' +
      '<span class="badge ' + statusClass[st] + '">' + esc(statusLabel[st]) + '</span></div>';

    /* progress */
    if (p.hasTasks) {
      h += '<div class="meter" style="margin:.2rem 0 .15rem"><span style="width:' + p.pct + '%"></span></div>';
      h += '<p class="metric">' + progressLabel(c) + '</p>';
    }

    /* stage flow — compact for narrow inspector panel */
    if ((c.phases || []).length) h += '<div style="margin:.55rem 0">' + stageFlowHTML(c, {compact: true}) + '</div>';

    /* why snippet */
    if (c.why) {
      const snippet = c.why.length > 120 ? c.why.slice(0, 119) + "…" : c.why;
      h += '<p style="font-size:11px;color:var(--muted);margin:.4rem 0 .55rem;line-height:1.45">' + esc(snippet) + '</p>';
    }

    /* next action */
    if (st !== "done") {
      h += '<p class="eyebrow" style="margin-top:.5rem">Next task</p>';
      h += '<p style="font-size:11px;margin:.2rem 0 .5rem">' + inline(esc(nextTask)) + '</p>';
    }

    /* blocked by */
    if (blockedBy.length) {
      h += '<p class="eyebrow" style="color:#d97706">Blocked by</p>';
      h += '<div class="chips" style="margin-bottom:.35rem">' + blockedBy.map(chipLink).join("") + '</div>';
    }

    /* unlocks */
    if (unlocks.length) {
      h += '<p class="eyebrow">Unlocks</p>';
      h += '<div class="chips" style="margin-bottom:.35rem">' + unlocks.map(chipLink).join("") + '</div>';
    } else if (blks.length) {
      h += '<p class="eyebrow">Downstream</p>';
      h += '<div class="chips" style="margin-bottom:.35rem">' + blks.map(chipLink).join("") + '</div>';
    }

    if (dep.length && !blockedBy.length) {
      h += '<p class="eyebrow">Depends on</p>';
      h += '<div class="chips" style="margin-bottom:.35rem">' + dep.map(chipLink).join("") + '</div>';
    }

    h += '<p style="margin-top:.75rem"><a class="btn" href="#/c/' + encodeURIComponent(c.name) + '">Open detail</a></p>';
    return h;
  }

  /* ================================================================
     WORK GRAPH MODEL

     The graph answers one question: what can be worked on now, and what has
     to wait. Three derived facts carry that answer.

       level        longest-path depth over confirmed edges. Every change at
                    one level has all its prerequisites at lower levels, so a
                    level is exactly the set that can run in parallel.
       status       ready / in-progress / blocked / waiting / done, from
                    changeStatus(), which reads lifecycle plus dependency
                    completion.
       criticalPath the longest chain. Slipping any change on it slips the
                    whole graph.

     Layout is a compound node per level, so the parallelism is a visible box
     rather than something the reader has to infer from arrow directions.
     ================================================================ */
  const trunc = (s, n) => s && s.length > n ? s.slice(0, n - 1) + "…" : (s || "");

  /* levels() returns an array of arrays: levels()[d] is the change names at
     depth d, sorted with actionable work first. A dependency cycle would make
     depth unbounded, so the walk is memoized and cycle-guarded. */
  function levels() {
    const names = changes.map((c) => c.name);
    const known = new Set(names);
    const preds = {};
    names.forEach((n) => { preds[n] = []; });
    edges.forEach((e) => {
      if (known.has(e.from) && known.has(e.to)) preds[e.to].push(e.from);
    });

    const depth = {}, visiting = new Set();
    function depthOf(n) {
      if (depth[n] !== undefined) return depth[n];
      if (visiting.has(n)) return 0;          /* cycle: stop descending */
      visiting.add(n);
      let d = 0;
      for (const p of preds[n]) d = Math.max(d, depthOf(p) + 1);
      visiting.delete(n);
      depth[n] = d;
      return d;
    }
    names.forEach(depthOf);

    const rank = { "in-progress": 0, ready: 1, blocked: 2, waiting: 3, done: 4 };
    const out = [];
    names.forEach((n) => {
      const d = depth[n];
      (out[d] = out[d] || []).push(n);
    });
    for (let d = 0; d < out.length; d++) {
      out[d] = (out[d] || []).sort((a, b) => {
        const ra = rank[changeStatus(byName.get(a))] ?? 9;
        const rb = rank[changeStatus(byName.get(b))] ?? 9;
        return ra - rb || a.localeCompare(b);
      });
    }
    return out;
  }

  /* readyNow lists the changes a person could pick up today: nothing upstream
     is outstanding and the work has not started. */
  function readyNow() {
    return changes.filter((c) => changeStatus(c) === "ready").map((c) => c.name).sort();
  }

  const STATUS_META = {
    "in-progress": { label: "In progress", color: "#4f46e5" },
    ready:         { label: "Ready",       color: "#16a34a" },
    blocked:       { label: "Blocked",     color: "#f97316" },
    waiting:       { label: "Waiting",     color: "#9ca3af" },
    done:          { label: "Done",        color: "#d1d5db" },
  };

  /* graphElems builds one compound parent per level plus one node per change.
     Suggested edges are drawn only when they are not already confirmed. */
  function graphElems(levelList, critical) {
    const elems = [];
    levelList.forEach((names, d) => {
      if (!names.length) return;
      const parallel = names.length > 1 ? names.length + " in parallel" : "1 change";
      elems.push({
        group: "nodes",
        data: { id: "level:" + d, label: "Level " + (d + 1) + " · " + parallel, type: "level" },
      });
      names.forEach((n) => {
        const c    = byName.get(n);
        const prog = progressOf(c);
        const st   = changeStatus(c);
        const line2 = STATUS_META[st].label + " · " + prog.pct + "%";
        elems.push({
          group: "nodes",
          data: {
            id: n, parent: "level:" + d, type: "change",
            label: trunc(n, 22) + "\n" + line2,
            status: st, critical: critical.has(n) ? 1 : 0,
          },
        });
      });
    });

    const confirmed = new Set(edges.map((e) => e.from + ":" + e.to));
    edges.forEach((e) => {
      const onCritical = critical.has(e.from) && critical.has(e.to);
      elems.push({
        group: "edges",
        data: {
          id: "dep:" + e.from + ":" + e.to, source: e.from, target: e.to,
          type: "cross", edgeStatus: edgeStatus(e.from), critical: onCritical ? 1 : 0,
        },
      });
    });
    novelCandidateGroups().forEach((c) => {
      if (!confirmed.has(c.from + ":" + c.to)) {
        elems.push({
          group: "edges",
          data: { id: "sug:" + c.from + ":" + c.to, source: c.from, target: c.to, suggested: true },
        });
      }
    });
    return elems;
  }

  /* ---- Cytoscape graph initialiser ---- */
  function initCy(containerId, levelList, critical) {
    if (typeof cytoscape === "undefined") {
      document.getElementById(containerId).innerHTML =
        '<div class="graph-empty">Cytoscape failed to load. Check the network connection.</div>';
      return;
    }
    destroyCy();

    cyInstance = cytoscape({
      container: document.getElementById(containerId),
      elements: graphElems(levelList, critical),
      style: [
        /* level container — the parallelism boundary */
        { selector: 'node[type = "level"]', style: {
          shape: "round-rectangle", "corner-radius": 10,
          "background-color": "#f9fafb", "background-opacity": 1,
          "border-width": 1, "border-color": "#e5e7eb", "border-style": "dashed",
          label: "data(label)", "text-valign": "top", "text-halign": "center",
          "text-margin-y": -6, "font-size": 10, "font-weight": 600,
          color: "#6b7280", padding: 18,
        } },
        /* change node — clean white card */
        { selector: 'node[type = "change"]', style: {
          shape: "round-rectangle", "corner-radius": 6, width: 172, height: 54,
          "background-color": "#ffffff", "border-width": 2, "border-color": "#e5e7eb",
          label: "data(label)",
          "font-family": '-apple-system,BlinkMacSystemFont,"Inter","Segoe UI",Arial,sans-serif',
          "font-size": 10.5, "text-valign": "center", "text-halign": "center",
          color: "#374151", "text-wrap": "wrap", "text-max-width": 156,
        } },
        /* status drives colour — readiness, not just lifecycle */
        { selector: 'node[status = "done"]',        style: { "background-color": "#f9fafb", "border-color": "#e5e7eb", color: "#9ca3af" } },
        { selector: 'node[status = "in-progress"]', style: { "background-color": "#eef2ff", "border-color": "#4f46e5", color: "#3730a3" } },
        { selector: 'node[status = "blocked"]',     style: { "background-color": "#fff7ed", "border-color": "#f97316", color: "#9a3412" } },
        { selector: 'node[status = "ready"]',       style: { "background-color": "#f0fdf4", "border-color": "#16a34a", color: "#14532d" } },
        { selector: 'node[status = "waiting"]',     style: { "background-color": "#ffffff", "border-color": "#d1d5db", color: "#6b7280" } },
        /* critical path — a heavier amber outline on nodes and edges */
        { selector: 'node[critical = 1]', style: { "border-width": 3, "border-color": "#f59e0b" } },
        { selector: "node.focused", style: { "overlay-color": "#4f46e5", "overlay-opacity": 0.08, "overlay-padding": 5 } },
        { selector: "node.dim",     style: { opacity: 0.2 } },
        /* edges */
        { selector: "edge", style: {
          "curve-style": "bezier", "target-arrow-shape": "triangle", "arrow-scale": .85,
          "line-color": "#d1d5db", "target-arrow-color": "#d1d5db", width: 1.5,
        } },
        { selector: 'edge[edgeStatus = "satisfied"]', style: { "line-color": "#86efac", "target-arrow-color": "#86efac", width: 1.5 } },
        { selector: 'edge[edgeStatus = "blocking"]',  style: { "line-color": "#f97316", "target-arrow-color": "#f97316", width: 2, "line-style": "dashed", "line-dash-pattern": [8, 4] } },
        { selector: 'edge[critical = 1]',             style: { "line-color": "#f59e0b", "target-arrow-color": "#f59e0b", width: 3, "line-style": "solid" } },
        { selector: "edge[?suggested]",               style: { "line-color": "#c7d2fe", "target-arrow-color": "#c7d2fe", width: 1, "line-style": "dotted" } },
        { selector: "edge.dim",                       style: { opacity: 0.08 } },
        { selector: "edge.focused",                   style: { "line-color": "#4f46e5", "target-arrow-color": "#4f46e5", width: 2.5 } },
      ],
      /* Levels are columns, so the layout only has to stack changes inside
         each one. Preset positions keep that exact, which a force layout
         would not. */
      layout: { name: "preset", positions: levelPositions(levelList), padding: 44, fit: true },
      userZoomingEnabled: true, userPanningEnabled: true, boxSelectionEnabled: false,
      maxZoom: 2, minZoom: 0.08,
    });

    const inspBody = document.getElementById("graph-inspector-body");
    const resetInspector = () => {
      if (inspBody) inspBody.innerHTML = '<p class="empty" style="margin-top:0">Hover a change to inspect it.</p>';
    };

    cyInstance.on("mouseover", 'node[type = "change"]', function (evt) {
      const node = evt.target;
      if (inspBody) inspBody.innerHTML = inspectorHTML(node.id());
      cyInstance.elements().addClass("dim");
      node.removeClass("dim").addClass("focused");
      node.parent().removeClass("dim");
      const conn = node.connectedEdges();
      conn.removeClass("dim").addClass("focused");
      conn.connectedNodes().removeClass("dim").parent().removeClass("dim");
    });

    cyInstance.on("mouseout", 'node[type = "change"]', function () {
      cyInstance.elements().removeClass("dim focused");
      resetInspector();
    });

    cyInstance.on("tap", 'node[type = "change"]', function (evt) {
      const id = evt.target.id();
      if (byName.has(id)) location.hash = "#/c/" + encodeURIComponent(id);
    });

    cyInstance.fit(undefined, 40);
  }

  /* Layout constants shared by the position function and the canvas sizing, so
     the box is never taller than the graph it holds. */
  const COL_W = 260, ROW_H = 104;

  /* levelPositions stacks each level's changes in a column at its depth. */
  function levelPositions(levelList) {
    const pos = {};
    levelList.forEach((names, d) => {
      (names || []).forEach((n, i) => { pos[n] = { x: d * COL_W, y: i * ROW_H }; });
    });
    return (node) => pos[node.id()] || { x: 0, y: 0 };
  }

  /* canvasHeight sizes the box to the graph rather than to the viewport. A
     shallow graph in a viewport-tall box reads as missing data. Derived from
     the level model directly, so it needs no post-layout measurement. */
  function canvasHeight(levelList) {
    const widest = levelList.reduce((m, w) => Math.max(m, (w || []).length), 1);
    return Math.max(300, Math.min(widest * ROW_H + 150, Math.round(window.innerHeight * 0.68)));
  }

  /* ---- phase progress chart ---- */
  function cssVar(n) { return getComputedStyle(document.documentElement).getPropertyValue(n).trim() || "#888"; }
  function initPhaseChart(c) {
    if (typeof Chart === "undefined") return;
    const ctx = document.getElementById("phasechart");
    if (!ctx) return;
    const labels = c.phases.map((p) => "Stage " + p.number);
    const done   = c.phases.map((p) => p.items.filter((i) => i.done).length);
    const rem    = c.phases.map((p) => p.items.length - p.items.filter((i) => i.done).length);
    const reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ink = cssVar("--ink"), muted = cssVar("--muted"), surface = cssVar("--surface-2");
    window.__chart = new Chart(ctx, {
      type: "bar",
      data: {
        labels,
        datasets: [
          { label: "Done", data: done, backgroundColor: ink, borderWidth: 0, borderRadius: 0 },
          { label: "Rem",  data: rem,  backgroundColor: surface, borderWidth: 1, borderColor: muted, borderRadius: 0 },
        ],
      },
      options: {
        indexAxis: "y", responsive: true, maintainAspectRatio: false,
        animation: reduce ? false : { duration: 200 },
        scales: {
          x: { stacked: true, beginAtZero: true, ticks: { precision: 0, font: { family: "monospace", size: 10 }, color: muted }, grid: { display: false } },
          y: { stacked: true, ticks: { font: { family: "monospace", size: 10 }, color: ink }, grid: { display: false } },
        },
        plugins: { legend: { display: false } },
      },
    });
  }

  /* ---- stat tile ---- */
  function stat(n, label) {
    return '<div class="stat"><b class="tnum">' + (n || 0) + "</b><span>" + label + "</span></div>";
  }

  /* criticalPath returns the set of change names on the longest dependency path.
     Only meaningful when edges exist; single-node graphs have no critical path. */
  function criticalPath() {
    const names = changes.map((c) => c.name);
    if (!names.length || !edges.length) return new Set();
    const adj = {};
    names.forEach((n) => { adj[n] = []; });
    edges.forEach((e) => { if (adj[e.from]) adj[e.from].push(e.to); });
    const memo = {};
    function longest(n) {
      if (memo[n] !== undefined) return memo[n];
      const succs = adj[n] || [];
      if (!succs.length) { memo[n] = [n]; return [n]; }
      let best = [];
      succs.forEach((s) => { const p = longest(s); if (p.length > best.length) best = p; });
      memo[n] = [n, ...best];
      return memo[n];
    }
    const hasIncoming = new Set(edges.map((e) => e.to));
    const roots = names.filter((n) => !hasIncoming.has(n));
    let globalBest = [];
    roots.forEach((r) => { const p = longest(r); if (p.length > globalBest.length) globalBest = p; });
    return new Set(globalBest);
  }

  /* ================================================================
     KANBAN VIEW
     ================================================================ */
  /* reviewLineHTML puts the verdict on the board card, so "which of these has a
     human signed off on, and is that signature still valid" is answerable
     without opening each change. A never-reviewed change says nothing rather
     than reading as a failure. */
  function reviewLineHTML(c) {
    const r = c.review;
    if (!r || !r.decision) return "";
    const drifted = (c.phases || []).some((p) => (p.items || []).some((it) => it.drift === "new" || it.drift === "changed"));
    let label = "reviewed: " + esc(r.decision);
    let color = r.decision === "approved" ? "var(--done)" : "var(--muted)";
    if (r.stale) { label = "review stale: " + esc(r.decision); color = "var(--lc-active-ink)"; }
    else if (drifted) { label += " · tasks moved"; color = "var(--lc-active-ink)"; }
    return '<p class="sub" style="color:' + color + ';margin-top:.1rem">' + label + "</p>";
  }

  function renderKanban() {
    destroyChart(); destroyCy();
    const tally = { active: 0, proposed: 0, archived: 0 };
    let done = 0, total = 0;
    changes.forEach((c) => {
      const p = progressOf(c);
      tally[c.lifecycle] = (tally[c.lifecycle] || 0) + 1;
      done += p.done; total += p.total;
    });
    const pct = total ? Math.round((done / total) * 100) : 0;

    let h = '<h1 tabindex="-1" id="view-title" style="margin-bottom:.65rem">Changes</h1>';
    h += '<div class="tally">' +
      stat(tally.active,   "active")   +
      stat(tally.proposed, "proposed") +
      stat(tally.archived, "archived") +
      '<div class="stat"><b class="tnum">' + done +
      '<span style="font-size:.6em;font-weight:400;color:var(--muted)">/' + total + '</span></b>' +
      '<span>tasks · ' + pct + '%</span></div></div>';

    const critical = criticalPath();
    const dotColors = {
      done: "#9ca3af", "in-progress": "#4f46e5",
      blocked: "#f97316", ready: "#16a34a", waiting: "#d1d5db"
    };

    h += '<div class="board">';
    LIFECYCLES.forEach((lc) => {
      const col = changes.filter((c) => c.lifecycle === lc);
      h += '<section class="col"><div class="col-head"><span class="badge ' + lc + '">' + lc +
        '</span><span class="ct">' + col.length + "</span></div><div class=\"col-body\">";
      if (!col.length) {
        h += '<p class="empty-col">None</p>';
      } else {
        col.forEach((c) => {
          const p = progressOf(c);
          const stgCount = (c.phases || []).length;
          const st = changeStatus(c);
          const dotColor = dotColors[st] || "#d1d5db";
          const dep = dependsOn(c.name);
          const blks = blocks(c.name);
          const blockedBy = dep.filter((d) => { const dc = byName.get(d); return !dc || dc.lifecycle !== "archived"; });
          let depLine = "";
          if ((st === "blocked" || st === "waiting") && blockedBy.length) {
            depLine = blockedBy.length === 1
              ? "blocked by " + esc(blockedBy[0])
              : "blocked by " + blockedBy.length + " changes";
          } else if (blks.length) {
            depLine = blks.length === 1
              ? "blocks " + esc(blks[0])
              : "blocks " + blks.length + " changes";
          }
          const depLineColor = (st === "blocked" || st === "waiting") ? "var(--lc-active-ink)" : "var(--muted)";
          h += '<button class="bcard" data-change="' + esc(c.name) + '">' +
            '<div style="display:flex;align-items:center;gap:.4rem;margin-bottom:.3rem">' +
              '<span style="width:8px;height:8px;border-radius:50%;background:' + dotColor + ';flex-shrink:0"></span>' +
              '<h3 style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin:0">' +
                esc(c.name) +
                (critical.has(c.name) ? ' <span title="Critical path" style="color:#f59e0b;font-size:10px">&#9733;</span>' : '') +
              '</h3>' +
              '<span class="badge ' + esc(c.lifecycle || "proposed") + '" style="flex-shrink:0;font-size:.65rem">' + esc(c.lifecycle || "proposed") + '</span>' +
            '</div>' +
            '<div class="meter"><span style="width:' + p.pct + '%"></span></div>' +
            '<p class="sub">' + progressLabel(c) + (stgCount ? ' &middot; ' + stgCount + (stgCount === 1 ? ' stage' : ' stages') : '') + '</p>' +
            (depLine ? '<p class="sub" style="color:' + depLineColor + ';margin-top:.1rem">' + depLine + '</p>' : '') +
            reviewLineHTML(c) +
            '</button>';
        });
      }
      h += "</div></section>";
    });
    h += "</div>";

    view.innerHTML = h;
    document.querySelectorAll(".bcard[data-change]").forEach((btn) => {
      btn.addEventListener("click", () => {
        location.hash = "#/c/" + encodeURIComponent(btn.getAttribute("data-change"));
      });
    });
    afterRender();
  }

  /* ================================================================
     GRAPH VIEW
     ================================================================ */
  /* The graph has two grains. Tasks is the default because it is the grain work
     actually happens at; Changes collapses to the workstream summary when the
     task graph is too large to read. The choice survives navigation. */
  let graphGrain = "tasks";

  function renderGraph() {
    destroyChart(); destroyCy();

    let h = '<h1 tabindex="-1" id="view-title" style="margin-bottom:.5rem">Work graph</h1>';
    if (!changes.length) {
      h += '<div class="graph-empty">No changes found.</div>';
      view.innerHTML = h; afterRender(); return;
    }

    const levelList = levels();
    const critical  = criticalPath();
    const ready     = readyNow();
    const novel     = novelCandidateGroups();
    const taskModel = taskGraph(levelList);

    const stCounts = {};
    changes.forEach((c) => { const st = changeStatus(c); stCounts[st] = (stCounts[st] || 0) + 1; });

    /* Lead with the answer: what is workable now, and how deep the chain runs. */
    h += '<div class="graph-lede">';
    h += '<div class="lede-block"><span class="lede-num tnum">' + ready.length + '</span>' +
         '<span class="lede-label">ready to start</span>' +
         (ready.length ? '<div class="chips">' + ready.map(chipLink).join("") + '</div>'
                       : '<p class="lede-note">Nothing is unblocked and unstarted.</p>') + '</div>';
    h += '<div class="lede-block"><span class="lede-num tnum">' + levelList.length + '</span>' +
         '<span class="lede-label">' + (levelList.length === 1 ? "level" : "levels") + ' deep</span>' +
         '<p class="lede-note">Everything at one level can run in parallel. Level N waits on level N-1.</p></div>';
    h += '<div class="lede-block"><span class="lede-num tnum">' + critical.size + '</span>' +
         '<span class="lede-label">on the critical path</span>' +
         '<p class="lede-note">The longest dependency chain. Slipping any of these slips everything.</p></div>';
    h += '</div>';

    /* status legend */
    h += '<div class="graph-status-bar">';
    Object.keys(STATUS_META).forEach((st) => {
      if (!stCounts[st]) return;
      h += '<span class="graph-status-chip" style="--chip-color:' + STATUS_META[st].color + '">' +
        '<span class="gsc-dot"></span>' + stCounts[st] + ' ' + STATUS_META[st].label + '</span>';
    });
    h += '</div>';

    h += '<div class="graph-toolbar">';
    h += '<div class="grain-switch" role="group" aria-label="Graph detail">';
    h += '<button type="button" class="grain-btn' + (graphGrain === "tasks" ? " on" : "") +
         '" data-grain="tasks">Tasks <span class="grain-ct">' + taskModel.nodes.length + '</span></button>';
    h += '<button type="button" class="grain-btn' + (graphGrain === "changes" ? " on" : "") +
         '" data-grain="changes">Changes <span class="grain-ct">' + changes.length + '</span></button>';
    h += '</div>';
    h += '<span class="graph-hint-text">' + (graphGrain === "tasks"
      ? "Each dashed box is one change. Columns are dependency levels. Click a task to open its change."
      : "Each dashed box is one level. Hover a change to inspect it; click to open its detail.") + '</span>';
    h += '</div>';

    const canvasH = graphGrain === "tasks" ? taskCanvasHeight(taskModel) : canvasHeight(levelList);
    h += '<div class="graph-shell">';
    h += '<div class="graph-workbench">' +
      '<div id="cy-container" style="height:' + canvasH + 'px"></div>' +
      '<div class="graph-legend">' +
      '<span class="legend-item"><span class="legend-line critical"></span> critical path</span>' +
      '<span class="legend-item"><span class="legend-line blocking"></span> still blocking</span>' +
      '<span class="legend-item"><span class="legend-line satisfied"></span> satisfied</span>' +
      (graphGrain === "tasks"
        ? '<span class="legend-item"><span class="legend-line declared"></span> declared task dependency</span>'
        : '<span class="legend-item"><span class="legend-line suggested"></span> suggested, unconfirmed</span>') +
      '</div>' +
      '</div>';
    h += '<aside class="graph-inspector">' +
      '<div class="graph-inspector-head"><span>Inspector</span></div>' +
      '<div class="graph-inspector-body" id="graph-inspector-body">' +
      '<p class="empty" style="margin-top:0">Hover a node to inspect it.</p>' +
      '</div></aside></div>';

    /* Roster: the same model as the canvas, readable without a pointer. */
    h += '<div class="level-roster">';
    levelList.forEach((names, d) => {
      if (!names.length) return;
      h += '<section class="level-col"><div class="level-head">Level ' + (d + 1) +
        '<span class="ct">' + names.length + '</span></div><div class="level-body">';
      names.forEach((n) => {
        const c  = byName.get(n);
        const st = changeStatus(c);
        const pr = progressOf(c);
        h += '<a class="level-item" href="#/c/' + encodeURIComponent(n) + '">' +
          '<span class="gsc-dot" style="--chip-color:' + STATUS_META[st].color + '"></span>' +
          '<span class="level-name">' + esc(n) +
            (critical.has(n) ? ' <span title="Critical path" style="color:#f59e0b">&#9733;</span>' : '') +
          '</span>' +
          '<span class="level-meta">' + STATUS_META[st].label + ' · ' + pr.pct + '%</span>' +
          '</a>';
      });
      h += '</div></section>';
    });
    h += '</div>';

    if (novel.length) {
      h += '<div class="suggest-panel"><div class="suggest-head">Suggested edges <span>&mdash; inferred from shared capabilities, not yet confirmed (' + novel.length + ')</span></div>';
      h += '<div class="suggest-body"><table class="suggest-table"><thead><tr>' +
        '<th>Prerequisite</th><th>Dependent</th><th>Shared capabilities</th><th>Add to specutil.yaml</th>' +
        '</tr></thead><tbody>';
      novel.forEach((c) => {
        h += '<tr><td>' + chipLink(c.from) + '</td><td>' + chipLink(c.to) + '</td>' +
          '<td>' + c.capabilities.map((cap) => '<code>' + esc(cap) + '</code>').join(" ") + '</td>' +
          '<td><code style="font-size:10px;white-space:pre">' + esc(manifestSnippet(c)) + '</code></td></tr>';
      });
      h += '</tbody></table></div></div>';
    }

    view.innerHTML = h;
    view.querySelectorAll(".grain-btn[data-grain]").forEach((b) => {
      b.addEventListener("click", () => {
        graphGrain = b.getAttribute("data-grain");
        renderGraph();
      });
    });
    if (graphGrain === "tasks") initTaskCy("cy-container", taskModel);
    else initCy("cy-container", levelList, critical);
    afterRender();
  }

  /* ================================================================
     TASK GRAPH

     Nodes are tasks, grouped in a compound box per change. A task's column is
     its dependency level: the detail feed already ranks each task by the
     longest chain that must finish first, accounting for both declared
     dependencies and the sequence of stages. The change's own level offsets
     that rank, so a task never sits left of work in another change it waits on.

     Only declared task dependencies are drawn as edges. Stage ordering is
     already carried by the columns, and drawing it as edges would connect every
     task in one stage to every task in the next for no added information.
     ================================================================ */
  function taskGraph(levelList) {
    const changeLevel = {};
    levelList.forEach((names, d) => (names || []).forEach((n) => { changeLevel[n] = d; }));

    /* A change's tasks span as many columns as it has levels, so the next
       change cannot simply start one column later. Offset by the widest span
       of everything at earlier levels. */
    const spanAt = [];
    changes.forEach((c) => {
      const d = changeLevel[c.name] || 0;
      let span = 1;
      (c.phases || []).forEach((p) => (p.items || []).forEach((it) => {
        span = Math.max(span, (it.level || 0) + 1);
      }));
      spanAt[d] = Math.max(spanAt[d] || 1, span);
    });
    const offset = [];
    let acc = 0;
    for (let d = 0; d < Math.max(levelList.length, 1); d++) { offset[d] = acc; acc += (spanAt[d] || 1); }

    const nodes = [], edges = [], rowOf = {};
    let row = 0;
    changes.forEach((c) => {
      const items = (c.phases || []).flatMap((p) => (p.items || []).map((it) => ({ it, phase: p })));
      if (!items.length) return;
      const d = changeLevel[c.name] || 0;
      const base = offset[d] || 0;
      const perCol = {};
      const start = row;
      items.forEach(({ it, phase }) => {
        const col = base + (it.level || 0);
        perCol[col] = (perCol[col] || 0);
        const id = c.name + "\x00" + (it.id || it.key);
        rowOf[id] = start + perCol[col];
        nodes.push({
          id, changeId: c.name, taskId: it.id || "", key: it.key,
          label: trunc(plainText(it.text), 34) + (it.kind && it.kind !== "task" ? "\n" + it.kind : ""),
          done: !!it.done, kind: it.kind || "task", phase: phase.name,
          x: col, y: rowOf[id],
        });
        perCol[col]++;
      });
      const tallest = Math.max(...Object.values(perCol), 1);
      row = start + tallest + 1;

      /* Declared dependencies, resolved inside this change. */
      const byTaskId = new Map(items.filter((x) => x.it.id).map((x) => [x.it.id, x.it]));
      items.forEach(({ it }) => {
        (it.dependsOn || []).forEach((ref) => {
          if (!byTaskId.has(ref)) return;
          edges.push({
            source: c.name + "\x00" + ref,
            target: c.name + "\x00" + (it.id || it.key),
            satisfied: !!byTaskId.get(ref).done,
          });
        });
      });
    });
    return { nodes, edges, changeLevel };
  }

  const TASK_COL_W = 250, TASK_ROW_H = 62;

  function taskCanvasHeight(model) {
    const rows = model.nodes.reduce((m, n) => Math.max(m, n.y + 1), 1);
    return Math.max(320, Math.min(rows * TASK_ROW_H + 140, Math.round(window.innerHeight * 0.72)));
  }

  function initTaskCy(containerId, model) {
    if (typeof cytoscape === "undefined") {
      document.getElementById(containerId).innerHTML =
        '<div class="graph-empty">Cytoscape failed to load. Check the network connection.</div>';
      return;
    }
    destroyCy();
    if (!model.nodes.length) {
      document.getElementById(containerId).innerHTML =
        '<div class="graph-empty">No tasks defined. Switch to Changes for the workstream graph.</div>';
      return;
    }

    const elems = [];
    const pos = {};
    const seenChange = new Set();
    model.nodes.forEach((n) => {
      if (!seenChange.has(n.changeId)) {
        seenChange.add(n.changeId);
        const c  = byName.get(n.changeId);
        const st = changeStatus(c);
        const pr = progressOf(c);
        elems.push({ group: "nodes", data: {
          id: "grp:" + n.changeId, type: "changeGroup",
          label: n.changeId + " · " + STATUS_META[st].label + " · " + pr.pct + "%",
        } });
      }
      elems.push({ group: "nodes", data: {
        id: n.id, parent: "grp:" + n.changeId, type: "task",
        label: n.label, changeId: n.changeId, taskId: n.taskId, key: n.key,
        state: n.done ? "done" : "open", kind: n.kind,
      } });
      pos[n.id] = { x: n.x * TASK_COL_W, y: n.y * TASK_ROW_H };
    });
    model.edges.forEach((e, i) => {
      elems.push({ group: "edges", data: {
        id: "t:" + i, source: e.source, target: e.target,
        edgeStatus: e.satisfied ? "satisfied" : "blocking",
      } });
    });
    /* Cross-change dependencies connect the change boxes, not their tasks: the
       manifest states that one workstream waits on another, not which task. */
    edges.forEach((e) => {
      if (!seenChange.has(e.from) || !seenChange.has(e.to)) return;
      elems.push({ group: "edges", data: {
        id: "x:" + e.from + ":" + e.to, source: "grp:" + e.from, target: "grp:" + e.to,
        edgeStatus: edgeStatus(e.from), cross: 1,
      } });
    });

    cyInstance = cytoscape({
      container: document.getElementById(containerId),
      elements: elems,
      style: [
        { selector: 'node[type = "changeGroup"]', style: {
          shape: "round-rectangle", "corner-radius": 10,
          "background-color": "#f9fafb", "border-width": 1,
          "border-color": "#d1d5db", "border-style": "dashed",
          label: "data(label)", "text-valign": "top", "text-halign": "center",
          "text-margin-y": -6, "font-size": 10, "font-weight": 600,
          color: "#6b7280", padding: 16,
        } },
        { selector: 'node[type = "task"]', style: {
          shape: "round-rectangle", "corner-radius": 5, width: 196, height: 40,
          "background-color": "#ffffff", "border-width": 1.5, "border-color": "#c7d2fe",
          label: "data(label)",
          "font-family": '-apple-system,BlinkMacSystemFont,"Inter","Segoe UI",Arial,sans-serif',
          "font-size": 9.5, "text-valign": "center", "text-halign": "center",
          color: "#374151", "text-wrap": "wrap", "text-max-width": 178,
        } },
        { selector: 'node[state = "done"]',  style: { "background-color": "#f9fafb", "border-color": "#e5e7eb", color: "#9ca3af" } },
        { selector: 'node[state = "open"]',  style: { "background-color": "#ffffff", "border-color": "#c7d2fe", color: "#374151" } },
        { selector: 'node[kind = "verify"]',  style: { "border-color": "#60a5fa" } },
        { selector: 'node[kind = "apply"]',   style: { "border-color": "#f97316", "border-width": 2 } },
        { selector: 'node[kind = "confirm"]', style: { "border-color": "#16a34a" } },
        { selector: "node.focused", style: { "overlay-color": "#4f46e5", "overlay-opacity": 0.08, "overlay-padding": 4 } },
        { selector: "node.dim",     style: { opacity: 0.18 } },
        { selector: "edge", style: {
          "curve-style": "bezier", "target-arrow-shape": "triangle", "arrow-scale": .8,
          "line-color": "#c7d2fe", "target-arrow-color": "#c7d2fe", width: 1.4,
        } },
        { selector: 'edge[edgeStatus = "satisfied"]', style: { "line-color": "#86efac", "target-arrow-color": "#86efac" } },
        { selector: 'edge[edgeStatus = "blocking"]',  style: { "line-color": "#f97316", "target-arrow-color": "#f97316" } },
        { selector: 'edge[cross = 1]', style: { width: 2.5, "line-style": "dashed", "line-dash-pattern": [8, 4] } },
        { selector: "edge.dim",     style: { opacity: 0.07 } },
        { selector: "edge.focused", style: { "line-color": "#4f46e5", "target-arrow-color": "#4f46e5", width: 2.2 } },
      ],
      layout: { name: "preset", positions: (n) => pos[n.id()] || { x: 0, y: 0 }, padding: 44, fit: true },
      userZoomingEnabled: true, userPanningEnabled: true, boxSelectionEnabled: false,
      maxZoom: 2, minZoom: 0.05,
    });

    const inspBody = document.getElementById("graph-inspector-body");
    const reset = () => {
      if (inspBody) inspBody.innerHTML = '<p class="empty" style="margin-top:0">Hover a node to inspect it.</p>';
    };

    cyInstance.on("mouseover", 'node[type = "task"]', function (evt) {
      const node = evt.target;
      if (inspBody) inspBody.innerHTML = taskInspectorHTML(node);
      cyInstance.elements().addClass("dim");
      node.removeClass("dim").addClass("focused");
      node.parent().removeClass("dim");
      const conn = node.connectedEdges();
      conn.removeClass("dim").addClass("focused");
      conn.connectedNodes().removeClass("dim").parent().removeClass("dim");
    });
    cyInstance.on("mouseover", 'node[type = "changeGroup"]', function (evt) {
      if (inspBody) inspBody.innerHTML = inspectorHTML(evt.target.id().slice(4));
    });
    cyInstance.on("mouseout", "node", function () {
      cyInstance.elements().removeClass("dim focused");
      reset();
    });
    cyInstance.on("tap", "node", function (evt) {
      const id = evt.target.data("changeId") || evt.target.id().replace(/^grp:/, "");
      if (byName.has(id)) location.hash = "#/c/" + encodeURIComponent(id);
    });

    cyInstance.fit(undefined, 40);
  }

  /* taskInspectorHTML describes one task node: where it sits, what it waits on,
     and what waits on it. */
  function taskInspectorHTML(node) {
    const changeId = node.data("changeId");
    const taskId   = node.data("taskId");
    const c = byName.get(changeId);
    if (!c) return '<p class="empty" style="margin-top:0">No detail.</p>';

    let item = null, phaseName = "";
    (c.phases || []).forEach((p) => (p.items || []).forEach((it) => {
      if ((it.id || it.key) === (taskId || node.data("key"))) { item = it; phaseName = p.name; }
    }));
    if (!item) return inspectorHTML(changeId);

    let h = '<div style="font-size:10px;color:var(--muted);font-family:var(--font-mono);margin-bottom:.35rem">' +
      esc(changeId) + ' / ' + esc(phaseName) + '</div>';
    h += '<div class="task-card' + (item.done ? " done" : "") + '" style="margin:.2rem 0">' +
      '<div class="tc-status"><span class="tc-check' + (item.done ? " done" : "") + '">' +
      (item.done ? "&#10003;" : "&#9744;") + '</span><span class="tc-key">' + esc(item.key) + '</span></div>' +
      '<div class="tc-body"><div class="tc-title">' + inline(esc(item.text)) + '</div></div></div>';

    const all = (c.phases || []).flatMap((p) => p.items || []);
    const byId = new Map(all.filter((x) => x.id).map((x) => [x.id, x]));
    const waits = (item.dependsOn || []).map((r) => byId.get(r)).filter(Boolean);
    const feeds = all.filter((x) => (x.dependsOn || []).includes(item.id));

    const chipRow = (label, list) => {
      if (!list.length) return "";
      return '<p class="eyebrow" style="margin-top:.55rem">' + label + '</p><div class="chips">' +
        list.map((x) => '<span class="dep' + (x.done ? " dep-done" : "") + '" title="' +
          esc(plainText(x.text)) + '">' + esc(x.key) + '</span>').join(" ") + '</div>';
    };
    h += chipRow("Waits on", waits);
    h += chipRow("Unblocks", feeds);
    if (item.kind && item.kind !== "task") {
      h += '<p class="eyebrow" style="margin-top:.55rem">Step kind</p><p style="font-size:11px;margin:.15rem 0">' +
        esc(item.kind) + '</p>';
    }
    h += '<p style="margin-top:.7rem"><a class="btn" href="#/c/' + encodeURIComponent(changeId) + '">Open change</a></p>';
    return h;
  }

  /* ================================================================
     DRILLDOWN VIEW
     ================================================================ */
  /* phaseMarkerHTML renders whatever the extract pass lifted off a phase. A
     loop phase is not a checklist: it repeats until its stop condition holds, so
     showing the condition and the cap is the difference between a reader
     understanding the plan and misreading it as six one-shot steps. */
  function phaseMarkerHTML(p) {
    const m = p.markers || {};
    const keys = Object.keys(m);
    if (!keys.length) return "";
    const LABELS = { shape: "Shape", stop: "Runs until", maxIters: "Iteration cap" };
    const ORDER  = ["shape", "stop", "maxIters"];
    const ordered = ORDER.filter((k) => m[k]).concat(keys.filter((k) => !ORDER.includes(k)).sort());
    let h = '<dl class="marker-list">';
    ordered.forEach((k) => {
      h += '<dt>' + esc(LABELS[k] || k) + '</dt><dd>' + inline(esc(m[k])) + '</dd>';
    });
    return h + '</dl>';
  }

  /* driftBadge marks what moved since the recorded review. It is silent when
     the change was never reviewed: with no baseline, every task would read as
     new, which says nothing. */
  function driftBadge(it) {
    if (it.drift === "new")     return '<span class="drift new" title="Added after the review">new</span>';
    if (it.drift === "changed") return '<span class="drift changed" title="Reworded after the review">changed</span>';
    return "";
  }

  function taskRowHTML(it, siblings, changeName) {
    const done = it.done;
    const k = kindTag(it);
    const chips = tagChips(it) + inlineRefChips(it) + extRefChips(it);
    const waits = dependencyLabel(it, siblings);
    const note = it.identity ? getNote(changeName, it.identity) : null;
    const flagged = note && note.action === "drop";
    const hasNote = note && (note.comment || flagged);

    let ann = "";
    if (it.identity) {
      const dropped = note && note.action === "drop";
      ann = '<details class="ann"' + (hasNote ? " open" : "") + '>' +
        '<summary>' + (hasNote ? '<span class="has-note">&#9679; comment</span>' : "comment") + '</summary>' +
        '<textarea class="ann-input" rows="2" data-change="' + esc(changeName) + '" data-identity="' + esc(it.identity) +
          '" placeholder="What should change about this task?">' + esc(note ? note.comment : "") + '</textarea>' +
        '<label class="ann-drop"><input type="checkbox" class="ann-action" data-change="' + esc(changeName) +
          '" data-identity="' + esc(it.identity) + '"' + (dropped ? " checked" : "") + '> request removal</label>' +
        '</details>';
    }

    return '<div class="task-card' + (done ? " done" : "") + (flagged ? " flagged" : "") + '">' +
      '<div class="tc-status">' +
        '<span class="tc-check' + (done ? " done" : "") + '">' + (done ? "&#10003;" : "&#9744;") + '</span>' +
        '<span class="tc-key">' + esc(it.key) + '</span>' +
      '</div>' +
      '<div class="tc-body">' +
        '<div class="tc-title">' + (k ? k + ' ' : '') + inline(esc(it.text)) + driftBadge(it) + '</div>' +
        (waits ? '<div class="tc-waits">' + waits + '</div>' : '') +
        (chips ? '<div class="tc-chips">' + chips + '</div>' : '') +
        ann +
      '</div>' +
      '</div>';
  }

  /* dependencyLabel names what a task waits on, using each prerequisite's short
     key rather than its source identifier, so the detail view and the graph use
     one vocabulary. A prerequisite that is already done is not a blocker, so it
     is styled as satisfied. */
  function dependencyLabel(it, siblings) {
    const deps = it.dependsOn || [];
    if (!deps.length || !siblings) return "";
    const byId = new Map(siblings.filter((s) => s.id).map((s) => [s.id, s]));
    const parts = deps.map((id) => {
      const dep = byId.get(id);
      if (!dep) return '<span class="dep dep-missing">' + esc(id) + '</span>';
      return '<span class="dep' + (dep.done ? " dep-done" : "") + '" title="' +
        esc(plainText(dep.text)) + '">' + esc(dep.key) + '</span>';
    });
    return 'waits on ' + parts.join(" ");
  }

  /* ---- diff ----
     The diff is here for the same reason the tasks are: a reviewer judges the
     plan and the code that came out of it in one pass. A hunk takes a comment
     exactly like a task does, keyed by the hunk's own identity, and both leave
     in the same exported document. */
  function hunkCounts(f) {
    let add = 0, del = 0;
    (f.hunks || []).forEach((h) => (h.lines || []).forEach((l) => {
      if (l.kind === "add") add++;
      else if (l.kind === "delete") del++;
    }));
    return "+" + add + " -" + del;
  }

  function diffLinesHTML(h) {
    return '<pre class="diff-lines">' + (h.lines || []).map((l) => {
      const sign = l.kind === "add" ? "+" : l.kind === "delete" ? "-" : " ";
      return '<span class="l ' + esc(l.kind) + '">' + esc(sign + l.text) + "</span>";
    }).join("") + "</pre>";
  }

  function diffSectionHTML(c) {
    const d = c.diff;
    if (!d) return "";
    let h = '<p class="eyebrow" style="margin-top:1.25rem">Working tree diff</p>';
    if (d.note) return h + '<p class="diff-empty">No diff: ' + esc(d.note) + "</p>";
    const files = d.files || [];
    if (!files.length) return h + '<p class="diff-empty">No changes against ' + esc(d.base) + ".</p>";

    h += '<p class="diff-empty">' + files.length + " file(s) against " + esc(d.base) + "</p>";
    files.forEach((f) => {
      h += '<details class="diff-file"><summary>' +
        '<span class="status">' + esc(f.status) + "</span>" +
        "<span>" + esc(f.path) + "</span>" +
        '<span class="counts">' + hunkCounts(f) + "</span>" +
        "</summary>";
      (f.hunks || []).forEach((hk) => {
        const note = getNote(c.name, hk.identity);
        const marked = !!(note.comment.trim() || note.action === "drop");
        h += '<div class="hunk">' +
          '<div class="hunk-head">' + esc(hk.header) + "</div>" +
          diffLinesHTML(hk) +
          '<details class="ann"' + (marked ? " open" : "") + ">" +
            "<summary>" + (marked ? '<span class="has-note">&#9679; comment</span>' : "comment") + "</summary>" +
            '<textarea class="ann-input" rows="2" data-change="' + esc(c.name) + '" data-identity="' + esc(hk.identity) +
              '" placeholder="What should change about this hunk?">' + esc(note.comment) + "</textarea>" +
          "</details>" +
          "</div>";
      });
      if (!(f.hunks || []).length) {
        h += '<div class="hunk"><p class="diff-empty">No text hunks (binary or mode change only).</p></div>';
      }
      h += "</details>";
    });
    return h;
  }

  /* reviewPanelHTML is the return path. Everything above it in the page is a
     projection of what the agent wrote; this is the one place a reader writes
     back. The panel states what is already recorded, collects a decision and
     comments, and hands over a document rather than posting anywhere, because
     there is nothing here to post to. */
  const DECISIONS = [
    ["approved",          "Approve"],
    ["changes-requested", "Request changes"],
    ["commented",         "Comment only"],
  ];
  function reviewPanelHTML(c) {
    const v = getVerdict(c.name);
    let h = '<div class="panel"><div class="panel-title"><span class="panel-title-label">Review</span></div><div class="panel-body">';

    if (c.review && c.review.decision) {
      h += '<div class="review-standing' + (c.review.stale ? " stale" : "") + '">' +
        "Recorded: <b>" + esc(c.review.decision) + "</b>" +
        (c.review.stale
          ? "<br>The artifacts changed after this decision, so it no longer describes what you are reading."
          : "<br>This decision still describes the current artifacts.") +
        "</div>";
    }

    h += '<div class="review-decision">';
    DECISIONS.forEach(([value, label]) => {
      h += '<label><input type="radio" name="review-decision" value="' + value + '"' +
        (v.decision === value ? " checked" : "") + '> ' + esc(label) + "</label>";
    });
    h += "</div>";

    h += '<textarea class="ann-input" id="review-note" rows="3" ' +
      'placeholder="Overall note for the author">' + esc(v.note || "") + "</textarea>";

    h += '<div class="review-actions">' +
      '<button type="button" data-act="copy" class="primary">Copy feedback</button>' +
      '<button type="button" data-act="download">Download</button>' +
      "</div>";

    h += '<p class="review-hint"><span id="ann-count">' + annCount(c.name) + "</span> task comment(s). " +
      "Paste or pass the file to:<br><code>specutil review ingest</code></p>";
    h += '<p class="review-hint" id="review-flash" aria-live="polite"></p>';

    return h + "</div></div>";
  }

  function renderDetail(name) {
    destroyChart(); destroyCy();
    const c = byName.get(name);
    if (!c) { renderKanban(); return; }
    const prog = progressOf(c);
    const deps = dependsOn(name), blks = blocks(name);

    let h = '<a class="back" href="#/">&#9664; All changes</a>';
    h += '<div class="doc"><div style="display:flex;align-items:baseline;gap:.6rem;flex-wrap:wrap;margin-bottom:.65rem">';
    h += '<h1 tabindex="-1" id="view-title">' + esc(c.name) + "</h1>";
    h += '<span class="badge ' + esc(c.lifecycle) + '">' + esc(c.lifecycle) + "</span></div>";
    h += '<div class="doclayout"><div class="main">';

    /* Stage flow — compact overview of progress across stages */
    if ((c.phases || []).length) {
      h += '<p class="eyebrow" style="margin-top:0">Stages</p>';
      h += stageFlowHTML(c);
    }

    /* Narrative — collapsed by default (progressive disclosure) */
    if (c.why || c.whatChanges) {
      h += '<div class="narrative">';
      if (c.why) {
        h += '<details class="narrative-block"><summary class="narrative-summary">Why</summary>' +
          '<div class="narrative-body">' + md(c.why) + '</div></details>';
      }
      if (c.whatChanges) {
        h += '<details class="narrative-block"><summary class="narrative-summary">What changes</summary>' +
          '<div class="narrative-body">' + md(c.whatChanges) + '</div></details>';
      }
      h += '</div>';
    }

    /* Design sections — Goals, Decisions, Risks, Rollout, Migration */
    const dsec = c.design || {};
    const designFields = [
      { key: "context",       label: "Context" },
      { key: "goals",         label: "Goals" },
      { key: "nonGoals",      label: "Non-goals" },
      { key: "decisions",     label: "Decisions" },
      { key: "risks",         label: "Risks" },
      { key: "rollout",       label: "Rollout" },
      { key: "migration",     label: "Migration" },
      { key: "openQuestions", label: "Open questions" },
    ].filter((f) => dsec[f.key]);
    if (designFields.length) {
      h += '<div class="narrative" style="margin-top:.5rem">';
      designFields.forEach((f) => {
        h += '<details class="narrative-block"><summary class="narrative-summary">' + esc(f.label) + '</summary>' +
          '<div class="narrative-body">' + md(dsec[f.key]) + '</div></details>';
      });
      h += '</div>';
    }

    /* Tasks by stage — all closed by default; open-task stages get accent border */
    h += '<p class="eyebrow" style="margin-top:1.25rem">Tasks by stage</p>';
    (c.phases || []).forEach((p, _pi) => {
      const items  = p.items || [];
      const done   = items.filter((i) => i.done).length;
      const phPct  = items.length ? Math.round((done / items.length) * 100) : 0;
      const open   = done < items.length;
      h += '<details class="phase-block' + (open ? " has-open" : "") + '"><summary class="phase-h">' +
        '<h2>' + esc(p.number) + ". " + esc(p.name) +
        (open ? '<span class="phase-open-badge">' + (items.length - done) + ' open</span>' : "") +
        "</h2>" +
        '<span class="ct tnum">' + done + "/" + items.length + " &middot; " + phPct + "%</span></summary>";
      h += '<div class="meter" style="margin:.2rem 0 .4rem"><span style="width:' + phPct + '%"></span></div>';
      h += phaseMarkerHTML(p);
      h += '<div class="task-list">';
      items.forEach((it) => { h += taskRowHTML(it, items, c.name); });
      h += "</div></details>";
    });

    h += diffSectionHTML(c);

    h += "</div>"; /* end .main */

    /* Rail — Review first (it is the action), then Dependencies, then Progress */
    h += '<aside class="rail">';
    h += reviewPanelHTML(c);

    if (deps.length || blks.length) {
      h += '<div class="panel"><div class="panel-title"><span class="panel-title-label">Dependencies</span></div><div class="panel-body">';
      if (deps.length) {
        h += '<p class="eyebrow" style="margin-top:0">Depends on</p>';
        h += '<div class="chips">' + deps.map(chipLink).join("") + "</div>";
      }
      if (blks.length) {
        h += '<p class="eyebrow"' + (deps.length ? '' : ' style="margin-top:0"') + '>Blocks</p>';
        h += '<div class="chips">' + blks.map(chipLink).join("") + "</div>";
      }
      h += "</div></div>";
    }

    h += '<div class="panel"><div class="panel-title"><span class="panel-title-label">Progress</span></div><div class="panel-body">';
    h += '<div class="progress-big"><span class="num">' + prog.pct + '</span>' +
      '<span style="font-family:var(--font-mono);font-size:.875rem;color:var(--muted)">%</span>' +
      '<p class="label">' + progressLabel(c) + "</p></div>";
    h += '<div class="meter" style="margin:.4rem 0"><span style="width:' + prog.pct + '%"></span></div>';
    if ((c.phases || []).length) {
      h += '<div class="chartwrap" style="height:' + (c.phases.length * 26 + 14) + 'px">' +
        '<canvas id="phasechart"></canvas></div>';
    }
    h += "</div></div>";

    h += "</aside>";
    h += "</div></div>"; /* end doclayout + doc */

    view.innerHTML = h;
    if ((c.phases || []).length) initPhaseChart(c);
    afterRender();
  }

  /* ---- empty state ---- */
  function renderEmpty() {
    destroyChart(); destroyCy();
    view.innerHTML = '<h1 tabindex="-1" id="view-title">No changes found</h1>' +
      '<p class="empty" style="margin-top:.5rem">Create changes under <code>openspec/changes/&lt;name&gt;/</code>, then run <code>specutil web</code>.</p>';
    afterRender();
  }

  /* ---- routing ---- */
  function route() {
    if (!changes.length) { currentRoute = "/"; renderEmpty(); return; }
    const h = location.hash.replace(/^#/, "");
    const m = h.match(/^\/c\/(.+)$/);
    if (m) {
      const name = decodeURIComponent(m[1]);
      if (byName.has(name)) { currentRoute = "/c/" + name; renderDetail(name); return; }
    }
    if (h === "/graph") { currentRoute = "/graph"; renderGraph(); return; }
    currentRoute = "/"; renderKanban();
  }

  /* ================================================================
     ANNOTATION WIRING

     Every handler is delegated from the view container and mutates only the
     annotation maps, never the DOM the router owns. A keystroke must not
     re-render: a re-render would move focus out of the textarea the reviewer
     is typing into.
     ================================================================ */
  function currentChange() {
    const m = currentRoute.match(/^\/c\/(.+)$/);
    return m ? m[1] : "";
  }
  function refreshAnnCount(name) {
    const el = document.getElementById("ann-count");
    if (el) el.textContent = String(annCount(name));
  }
  function refreshAnnSummary(input) {
    const det = input.closest("details.ann");
    if (!det) return;
    const sum = det.querySelector("summary");
    if (!sum) return;
    const n = getNote(input.dataset.change, input.dataset.identity);
    const marked = !!(n.comment.trim() || n.action === "drop");
    sum.innerHTML = marked ? '<span class="has-note">&#9679; comment</span>' : "comment";
  }

  view.addEventListener("input", (ev) => {
    const t = ev.target;
    if (t.classList && t.classList.contains("ann-input") && t.dataset.identity) {
      setNote(t.dataset.change, t.dataset.identity, { comment: t.value });
      refreshAnnSummary(t);
      refreshAnnCount(t.dataset.change);
      return;
    }
    if (t.id === "review-note") {
      const name = currentChange();
      if (name) verdicts.set(name, { ...getVerdict(name), note: t.value });
    }
  });

  view.addEventListener("change", (ev) => {
    const t = ev.target;
    if (t.classList && t.classList.contains("ann-action")) {
      setNote(t.dataset.change, t.dataset.identity, { action: t.checked ? "drop" : "comment" });
      const card = t.closest(".task-card");
      if (card) card.classList.toggle("flagged", t.checked);
      const box = t.closest("details.ann");
      const input = box && box.querySelector(".ann-input");
      if (input) refreshAnnSummary(input);
      refreshAnnCount(t.dataset.change);
      return;
    }
    if (t.name === "review-decision") {
      const name = currentChange();
      if (name) verdicts.set(name, { ...getVerdict(name), decision: t.value });
    }
  });

  view.addEventListener("click", (ev) => {
    const b = ev.target.closest && ev.target.closest("button[data-act]");
    if (!b) return;
    const name = currentChange();
    if (!name) return;
    if (b.dataset.act === "copy") copyText(feedbackJSON(name), "Copied the feedback JSON. Run: pbpaste | specutil review ingest");
    if (b.dataset.act === "download") downloadJSON(name);
  });

  /* ---- tabs + afterRender ---- */
  function afterRender() {
    const t = document.getElementById("view-title");
    if (t) { t.focus(); if (live) live.textContent = t.textContent; }
    syncTabs();
  }
  const navTabs = document.getElementById("nav-tabs");
  function syncTabs() {
    navTabs.querySelectorAll("a").forEach((a) => {
      const r = a.getAttribute("data-route");
      const on = (r === "/" && (currentRoute === "/" || currentRoute.startsWith("/c/"))) ||
                 (r === "/graph" && currentRoute === "/graph");
      a.classList.toggle("on", !!on);
    });
  }
  if (changes.length) {
    [["/" , "Kanban"], ["/graph", "Graph"]].forEach(([r, label]) => {
      const a = document.createElement("a");
      a.href = "#" + r; a.textContent = label; a.setAttribute("data-route", r);
      navTabs.appendChild(a);
    });
  }

  /* ---- diagnostics banner ---- */
  const bannerIssues = diags.concat(feedIssues);
  if (bannerIssues.length) {
    const b = document.getElementById("diag-banner");
    const kinds = [...new Set(bannerIssues.map((d) => d.kind))].join(", ");
    b.innerHTML = "<b>Data problems (" + esc(kinds) + "):</b><ul>" +
      bannerIssues.map((d) => "<li>" + esc(d.msg) + "</li>").join("") + "</ul>";
    b.hidden = false;
  }
  if (window.__cdnFail && window.__cdnFail.length) document.getElementById("offline-note").hidden = false;

  window.addEventListener("hashchange", route);
  route();
})();
</script>
</body>
</html>

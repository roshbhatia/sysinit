#!/bin/sh
# A stand-in for Claude Code that writes a fixed stream-json run, slowly enough that the
# progress view has to draw every stage of it. No model is called, so the run is the same
# every time and the test is about the view rather than about an answer.
cat > /dev/null

say() {
	printf '%s\n' "$1"
	sleep "$2"
}

say '{"type":"system","subtype":"init","model":"claude-opus-5","tools":["Bash","Read","Edit","Grep"]}' 0.8
say '{"type":"assistant","message":{"content":[{"type":"text","text":"Looking at the file first.\nThen the imports."}]}}' 0.6
say '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Read","input":{"file_path":"/tmp/report.txt"}}]}}' 0.6
say '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Bash","input":{"command":"wc -l /tmp/report.txt"}}]}}' 0.6
say '{"type":"rate_limit_event"}' 0.6
say '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Grep","input":{"pattern":"error"}}]}}' 0.6
say '{"type":"result","subtype":"success","result":"THE ANSWER AND NOTHING ELSE","session_id":"s1","total_cost_usd":0.0421,"duration_ms":4200,"num_turns":3}' 0.2

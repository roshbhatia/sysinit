#!/bin/sh
# The progress view only exists when stderr is a terminal, so the only place it can be
# checked is a terminal. This serves repeated ask runs over ttyd; a browser then reads
# xterm.js's own buffer, which is the authority on what each character cell holds.
#
#   nix build nixpkgs#ttyd --no-link --print-out-paths
#   <that>/bin/ttyd -p 7681 -i 127.0.0.1 -W pkgs/ask/testdata/pty/serve
#
# Then, in the browser at http://127.0.0.1:7681, sample the buffer:
#
#   const b = window.term.buffer.active
#   [...Array(b.length)].map((_, i) => b.getLine(i).translateToString(true))
#
# The run repeats because a round trip to the browser takes longer than one run: a single
# run would be over before the first frame could be read. ttyd also kills the run when the
# browser disconnects, which is why the answers accumulate in a file rather than replacing
# each other.
set -e
here="$(cd "$(dirname "$0")" && pwd)"
work="${TMPDIR:-/tmp}/ask-pty"

rm -rf "$work"
mkdir -p "$work/bin"

# The fake has to answer to the name the provider looks for, and the link is made outside
# the repository so that running this leaves nothing behind in it.
ln -s "$here/fake-claude" "$work/bin/claude"

export PATH="$work/bin:$PATH"
export XDG_STATE_HOME="$work/state"

while true; do
	# stdout to a file and stderr to the terminal: this is the claim ask makes, and a pty is
	# the only place it can be checked. Anything drawn on screen that reaches the file is a
	# bug, and an empty file is one too.
	echo "some input" | ask summarise this > "$work/stdout.txt"
	cat "$work/stdout.txt" >> "$work/answers.txt"
	printf 'RUN OVER, answers so far: %s\n' "$(wc -l < "$work/answers.txt" | tr -d ' ')"
	sleep 2
	clear
done

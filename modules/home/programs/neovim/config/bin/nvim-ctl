#!/usr/bin/env bash
# Drive a running Neovim from an out-of-process agent.
#
# Transport is Neovim's own RPC socket, reached with `nvim --server
# --remote-expr`. Nothing to install, no daemon, no second socket.
#
# Usage:
#   nvim-ctl list
#   nvim-ctl adopt [--cwd DIR]
#   nvim-ctl <op> [key=value ...]
#   nvim-ctl raw '<json>'
#
# Ops: open, goto_line, highlight, annotate, split_open, clear, diff,
#      context, selection, diagnostics, preview, notify, command
#
# Examples:
#   nvim-ctl open path=auth/handler.go line=45
#   nvim-ctl highlight from=45 to=62 label="entry point"
#   nvim-ctl annotate line=51 text="JWT validated here"
#   nvim-ctl split_open path=auth/middleware.go line=20
#   nvim-ctl context
#
# Socket selection, in order:
#   1. $NVIM_HOST_SOCKET (exported into every harness-spawned agent pane)
#   2. $NVIM (set when running inside a :terminal)
#   3. the single live instance in the registry, matched on cwd when ambiguous

set -euo pipefail

REGISTRY="${XDG_STATE_HOME:-$HOME/.local/state}/nvim/harness/instances"

die() {
	printf 'nvim-ctl: %s\n' "$*" >&2
	exit 1
}

command -v jq >/dev/null 2>&1 || die "jq is required"
command -v nvim >/dev/null 2>&1 || die "nvim is required"

# One JSON record per line. Records whose socket no longer exists belong to an
# nvim that died hard, so drop them rather than reporting a dead editor.
live_records() {
	[ -d "$REGISTRY" ] || return 0
	local f sock
	for f in "$REGISTRY"/*.json; do
		[ -e "$f" ] || continue
		sock=$(jq -r '.socket // empty' <"$f" 2>/dev/null || true)
		if [ -n "$sock" ] && [ -S "$sock" ]; then
			jq -c . <"$f"
		else
			rm -f "$f"
		fi
	done
}

# Prefer an instance whose cwd contains ours: a repo root and a subdirectory are
# one session from the user's point of view.
resolve_socket() {
	if [ -n "${NVIM_HOST_SOCKET:-}" ] && [ -S "$NVIM_HOST_SOCKET" ]; then
		printf '%s' "$NVIM_HOST_SOCKET"
		return 0
	fi
	if [ -n "${NVIM:-}" ] && [ -S "$NVIM" ]; then
		printf '%s' "$NVIM"
		return 0
	fi
	local records here sock
	records=$(live_records)
	[ -n "$records" ] || return 1
	here=$(pwd -P)
	sock=$(printf '%s\n' "$records" |
		jq -rs --arg here "$here" '
			(map(select(($here == .cwd) or ($here | startswith(.cwd + "/")))) | first)
			// first
			| .socket // empty
		')
	[ -n "$sock" ] || return 1
	printf '%s' "$sock"
}

send() {
	local json=$1 sock ctl
	sock=$(resolve_socket) || die "no running Neovim found (try: nvim-ctl adopt)"
	ctl=$(mktemp)
	printf '%s\n' "$json" >"$ctl"
	# luaeval's _A carries the path, which sidesteps nested shell quoting.
	nvim --server "$sock" --remote-expr \
		"luaeval('require(\"harness.control\").rpc(_A)', '$ctl')"
	printf '\n'
	rm -f "$ctl"
}

# key=value pairs to a flat JSON object. jq does the escaping; digits stay
# numbers so the Lua side never has to guess at a type.
kv_to_json() {
	local op=$1
	shift
	local args=(--arg op "$op")
	# shellcheck disable=SC2016  # $op is a jq variable, not a shell one
	local filter='{op: $op}'
	local i=0 pair key val
	for pair in "$@"; do
		key=${pair%%=*}
		val=${pair#*=}
		if [[ $val =~ ^-?[0-9]+$ ]]; then
			args+=(--argjson "v$i" "$val")
		else
			args+=(--arg "v$i" "$val")
		fi
		filter="$filter + {\"$key\": \$v$i}"
		i=$((i + 1))
	done
	jq -cn "${args[@]}" "$filter"
}

cmd=${1:-}
[ -n "$cmd" ] || die "usage: nvim-ctl <list|adopt|raw|op> [key=value ...]"
shift || true

case "$cmd" in
list)
	live_records
	;;
adopt)
	target_cwd=$(pwd -P)
	while [ $# -gt 0 ]; do
		case "$1" in
		--cwd)
			target_cwd=$2
			shift 2
			;;
		*) shift ;;
		esac
	done
	if existing=$(resolve_socket 2>/dev/null); then
		printf 'already attached: %s\n' "$existing"
		exit 0
	fi
	[ -n "${WEZTERM_PANE:-}" ] || die "not in a wezterm pane; start nvim yourself"
	command -v wezterm >/dev/null 2>&1 || die "wezterm cli not found"
	# The agent owns the left pane in this flow, so the editor opens right.
	wezterm cli split-pane --pane-id "$WEZTERM_PANE" --right --percent 60 \
		--cwd "$target_cwd" -- nvim >/dev/null
	# nvim registers on startup, so wait for the record rather than guessing.
	for _ in $(seq 1 40); do
		if sock=$(resolve_socket 2>/dev/null); then
			printf 'adopted: %s\n' "$sock"
			exit 0
		fi
		sleep 0.25
	done
	die "nvim did not register within 10s"
	;;
raw)
	send "${1:-}"
	;;
*)
	send "$(kv_to_json "$cmd" "$@")"
	;;
esac

#compdef tq

_tq() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -C \
    '--state[Execution record directory]:directory:_directories' \
    '1:action:(submit status browse attach thread logs reconcile cancel resume)' \
    '*::argument:->args'
  case $line[1] in
    submit)
      _arguments \
        '--task[Full Taskwarrior UUID]:UUID:' \
        '--thread[Exact captured-thread ID]:thread ID:' \
        '--session[Existing seshy session]:session:' \
        '--cwd[Working directory]:directory:_directories' \
        '--group[Pueue group]:group:(agents builds default)' \
        '--terminal[Run in a tab in the task-queue WezTerm workspace]' \
        '--retry[Create another attempt after completion]' \
        '*:command:_command_names'
      ;;
    browse)
      _arguments '--thread[Filter by captured-thread ID]:thread ID:'
      ;;
    logs)
      _arguments '1:execution attempt UUID:' '--pager[Open in the terminal pager]'
      ;;
    attach)
      _arguments '1:execution attempt UUID:' '--focus-only[Select the tab in the mux]'
      ;;
    cancel|resume|thread)
      _message 'execution attempt UUID'
      ;;
  esac
}

_tq "$@"

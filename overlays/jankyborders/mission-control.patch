--- /dev/null
+++ b/tests/mission_control_test.c
@@ -0,0 +1,145 @@
+#include "misc/helpers.h"
+#include "misc/event_payload.h"
+#include "misc/window.h"
+#include "windows.h"
+#include <assert.h>
+#include <libproc.h>
+
+struct table g_windows;
+bool g_mission_control_active;
+static bool exists[32];
+static int hidden, redrawn, focused;
+static int level = 19;
+static const char *owner = "WindowManager";
+static CGRect bounds = {{0, 0}, {1920, 1080}};
+static bool owner_failure, pid_failure, bounds_failure, display_failure;
+
+static CGError test_owner(int cid, uint32_t wid, int *out) {
+  (void)cid;
+  *out = exists[wid] ? 1 : 0;
+  return owner_failure ? kCGErrorFailure : kCGErrorSuccess;
+}
+
+static CGError test_pid(int cid, pid_t *pid) {
+  (void)cid;
+  *pid = 42;
+  return pid_failure ? kCGErrorFailure : kCGErrorSuccess;
+}
+
+static int test_name(int pid, void *name, uint32_t size) {
+  (void)pid;
+  return snprintf(name, size, "%s", owner);
+}
+
+static int test_level(int cid, uint32_t wid) {
+  (void)cid;
+  (void)wid;
+  return level;
+}
+
+static CGError test_bounds(int cid, uint32_t wid, CGRect *out) {
+  (void)cid;
+  (void)wid;
+  *out = bounds;
+  return bounds_failure ? kCGErrorFailure : kCGErrorSuccess;
+}
+
+static CGError test_displays(uint32_t size, CGDirectDisplayID *ids,
+                             uint32_t *count) {
+  *count = 1;
+  if (size)
+    ids[0] = 1;
+  return display_failure ? kCGErrorFailure : kCGErrorSuccess;
+}
+
+static CGRect test_display_bounds(CGDirectDisplayID display) {
+  (void)display;
+  return CGRectMake(0, 0, 1920, 1080);
+}
+
+void windows_hide_all(struct table *windows) {
+  (void)windows;
+  hidden++;
+}
+
+void windows_draw_borders_on_current_spaces(struct table *windows) {
+  (void)windows;
+  redrawn++;
+}
+
+void windows_determine_and_focus_active_window(struct table *windows) {
+  (void)windows;
+  focused++;
+}
+
+#undef DELAY_ASYNC_EXEC_ON_MAIN_THREAD
+#define DELAY_ASYNC_EXEC_ON_MAIN_THREAD(delay, code)                           \
+  do {                                                                         \
+    code                                                                       \
+  } while (0)
+#define SLSGetWindowOwner test_owner
+#define SLSConnectionGetPID test_pid
+#define SLSGetWindowBounds test_bounds
+#define CGGetActiveDisplayList test_displays
+#define CGDisplayBounds test_display_bounds
+#define proc_name test_name
+#define window_level test_level
+#include "misc/mission_control.h"
+
+static void test_window_payload(void) {
+  unsigned char data[17] = {0};
+  uint64_t expected_sid = 0x123456789abcdef0ULL;
+  uint32_t expected_wid = 0xdeadbeefU;
+  memcpy(data + 1, &expected_sid, sizeof(expected_sid));
+  memcpy(data + 9, &expected_wid, sizeof(expected_wid));
+  uint64_t sid = 0;
+  uint32_t wid = 0;
+  assert(!event_decode_window_spawn(NULL, 12, &sid, &wid));
+  assert(!event_decode_window_spawn(data + 1, 11, &sid, &wid));
+  assert(sid == 0 && wid == 0);
+  assert(event_decode_window_spawn(data + 1, 12, &sid, &wid));
+  assert(sid == expected_sid && wid == expected_wid);
+  assert(event_decode_window_spawn(data + 1, 16, &sid, &wid));
+  assert(sid == expected_sid && wid == expected_wid);
+}
+
+int main(void) {
+  test_window_payload();
+  exists[1] = exists[2] = true;
+  level = 18;
+  assert(!mission_control_is_backdrop(0, 1));
+  level = 19;
+  owner = "OtherApp";
+  assert(!mission_control_is_backdrop(0, 1));
+  owner = "WindowManager";
+  bounds.size.width = 100;
+  assert(!mission_control_is_backdrop(0, 1));
+  bounds.size.width = 1920;
+
+  bool *failures[] = {&owner_failure, &pid_failure, &bounds_failure,
+                      &display_failure};
+  for (size_t i = 0; i < sizeof(failures) / sizeof(failures[0]); i++) {
+    *failures[i] = true;
+    assert(!mission_control_is_backdrop(0, 1));
+    *failures[i] = false;
+  }
+
+  mission_control_window_created(0, 1);
+  mission_control_window_created(0, 1);
+  mission_control_window_created(0, 2);
+  assert(g_mission_control_active && hidden == 1);
+  assert(g_mission_control_backdrop_count == 2);
+
+  mission_control_window_destroyed(0, 1);
+  assert(g_mission_control_active && redrawn == 0);
+  exists[1] = false;
+  mission_control_window_destroyed(0, 1);
+  assert(g_mission_control_active && g_mission_control_backdrop_count == 1);
+  exists[2] = false;
+  mission_control_prune(0);
+  assert(!g_mission_control_active && redrawn == 1 && focused == 1);
+  mission_control_prune(0);
+  assert(redrawn == 1);
+  puts("Mission Control detection, query failures, and multi-display lifecycle "
+       "passed");
+}

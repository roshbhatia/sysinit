+void windows_hide_all(struct table* windows) {
+  for (int i = 0; i < windows->capacity; ++i) {
+    struct bucket* bucket = windows->buckets[i];
+    while (bucket) {
+      if (bucket->value) border_hide(bucket->value);
+      bucket = bucket->next;
+    }
+  }
+}

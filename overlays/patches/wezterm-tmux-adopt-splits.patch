+    /// Adopt panes that tmux created without us asking for them, as
+    /// `tmux split-window` does. A `-d` split never raises
+    /// `%window-pane-changed`, so `%layout-change` is the only notice we get.
+    fn adopt_unattached_panes(
+        &self,
+        window_id: TmuxWindowId,
+        panes: &[PaneItem],
+    ) -> anyhow::Result<()> {
+        let tab_id = {
+            let gui_tabs = self.gui_tabs.lock();
+            let Some(local_tab) = gui_tabs.get(&window_id) else {
+                return Ok(());
+            };
+            local_tab.tab_id
+        };
+
+        // Adopt top-left first, so each pane already has an attached
+        // neighbour by the time we place it.
+        let mut pending: Vec<&PaneItem> = panes
+            .iter()
+            .filter(|p| p.window_id == window_id && !self.check_pane_attached(window_id, p.pane_id))
+            .collect();
+        pending.sort_by_key(|p| (p.pane_top, p.pane_left));
+
+        let mut adopted = false;
+        for pane in pending {
+            let Some((origin, direction)) = self.find_split_origin(window_id, pane, panes) else {
+                log::warn!(
+                    "no attached neighbour for tmux pane %{}, cannot place it",
+                    pane.pane_id
+                );
+                continue;
+            };
+
+            let local_pane_id = {
+                let pane_map = self.remote_panes.lock();
+                let Some(ref_pane) = pane_map.get(&origin) else {
+                    continue;
+                };
+                let local_pane_id = ref_pane.lock().local_pane_id;
+                local_pane_id
+            };
+
+            let split_request = SplitRequest {
+                direction,
+                target_is_second: true,
+                top_level: false,
+                size: SplitSize::Cells(match direction {
+                    SplitDirection::Horizontal => pane.pane_width as usize,
+                    SplitDirection::Vertical => pane.pane_height as usize,
+                }),
+            };
+
+            let local_pane = match self.split_pane(tab_id, local_pane_id, pane.pane_id, split_request)
+            {
+                Ok(local_pane) => local_pane,
+                Err(err) => {
+                    log::error!("failed to adopt tmux pane %{}: {:#}", pane.pane_id, err);
+                    continue;
+                }
+            };
+
+            let _ = local_pane;
+            log::info!("adopted tmux pane %{}", pane.pane_id);
+            adopted = true;
+        }
+
+        // Reconcile EVERY pane in the window, not only the ones just adopted.
+        // `split_and_insert` takes the new pane's space out of the pane it split
+        // from, so an adoption resizes existing panes as a side effect. Telling
+        // tmux about only the new pane left its neighbours believing their old
+        // width, and tmux then wrapped their output to a width wezterm was not
+        // drawing at: the visible symptom was one teammate pane rendering as
+        // wrapped garbage while the rest looked fine.
+        if adopted {
+            self.reconcile_pane_sizes(window_id, panes);
+        }
+
+        Ok(())
+    }
+
+    /// Push tmux a resize for every attached pane in `window_id`, using the size
+    /// the tab's layout assigns it.
+    fn reconcile_pane_sizes(&self, window_id: TmuxWindowId, panes: &[PaneItem]) {
+        let tab_id = {
+            let gui_tabs = self.gui_tabs.lock();
+            let Some(local_tab) = gui_tabs.get(&window_id) else {
+                return;
+            };
+            local_tab.tab_id
+        };
+        let mux = Mux::get();
+        let Some(tab) = mux.get_tab(tab_id) else {
+            return;
+        };
+
+        // Sizes come from the tab's own layout, NOT from each pane's renderer.
+        // This runs on the mux thread immediately after `split_and_insert`, and
+        // the GUI has not sized the new panes yet at that point:
+        // `Pane::get_dimensions` then reports a single row or column. Sending
+        // that to tmux made it believe in a 1x133 pane and wrap every teammate's
+        // output to it. `iter_panes_ignoring_zoom` reports the layout that was
+        // just computed, which is correct synchronously.
+        let mut layout = HashMap::new();
+        for positioned in tab.iter_panes_ignoring_zoom() {
+            layout.insert(
+                positioned.pane.pane_id(),
+                (positioned.width, positioned.height),
+            );
+        }
+
+        for pane in panes {
+            if pane.window_id != window_id || !self.check_pane_attached(window_id, pane.pane_id) {
+                continue;
+            }
+            let local_pane_id = {
+                let pane_map = self.remote_panes.lock();
+                let Some(ref_pane) = pane_map.get(&pane.pane_id) else {
+                    continue;
+                };
+                // `split_pane` and `create_pane` record OUR size against the
+                // remote pane, so `Resize` would see no delta and emit nothing.
+                // Record what tmux currently believes, so the resize is real.
+                let mut ref_pane = ref_pane.lock();
+                ref_pane.pane_width = pane.pane_width;
+                ref_pane.pane_height = pane.pane_height;
+                ref_pane.local_pane_id
+            };
+            let Some(&(cols, rows)) = layout.get(&local_pane_id) else {
+                continue;
+            };
+            // A degenerate size means the layout still has not settled. Skip it
+            // rather than corrupt tmux: the next `%layout-change` brings us back
+            // here with real numbers.
+            if cols < 2 || rows < 2 {
+                log::debug!(
+                    "skipping resize of tmux pane %{}: layout not settled ({}x{})",
+                    pane.pane_id,
+                    cols,
+                    rows
+                );
+                continue;
+            }
+            self.cmd_queue.lock().push_back(Box::new(Resize {
+                pane_id: pane.pane_id,
+                size: PtySize {
+                    rows: rows as u16,
+                    cols: cols as u16,
+                    pixel_width: 0,
+                    pixel_height: 0,
+                },
+            }));
+        }
+    }
+
+    /// Find the attached pane that `pane` was split away from, by looking for
+    /// the neighbour sharing a full edge with it. tmux leaves a one cell
+    /// divider between panes, which is what the +1 accounts for.
+    fn find_split_origin(
+        &self,
+        window_id: TmuxWindowId,
+        pane: &PaneItem,
+        panes: &[PaneItem],
+    ) -> Option<(TmuxPaneId, SplitDirection)> {
+        panes.iter().find_map(|other| {
+            if other.pane_id == pane.pane_id || !self.check_pane_attached(window_id, other.pane_id) {
+                return None;
+            }
+            if other.pane_top == pane.pane_top
+                && other.pane_height == pane.pane_height
+                && other.pane_left + other.pane_width + 1 == pane.pane_left
+            {
+                return Some((other.pane_id, SplitDirection::Horizontal));
+            }
+            if other.pane_left == pane.pane_left
+                && other.pane_width == pane.pane_width
+                && other.pane_top + other.pane_height + 1 == pane.pane_top
+            {
+                return Some((other.pane_id, SplitDirection::Vertical));
+            }
+            None
+        })
+    }

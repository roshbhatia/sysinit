+fn escape_sequence_end(bytes: &[u8], start: usize) -> usize {
+    let Some(introducer) = bytes.get(start + 1).copied() else {
+        return bytes.len();
+    };
+
+    match introducer {
+        b'[' => bytes[start + 2..]
+            .iter()
+            .position(|byte| (0x40..=0x7e).contains(byte))
+            .map_or(bytes.len(), |offset| start + 3 + offset),
+        b']' | b'P' | b'X' | b'^' | b'_' => {
+            let mut cursor = start + 2;
+            while cursor < bytes.len() {
+                if introducer == b']' && bytes[cursor] == b'\x07' {
+                    return cursor + 1;
+                }
+                if bytes[cursor..].starts_with(b"\x1b\\") {
+                    return cursor + 2;
+                }
+                cursor += 1;
+            }
+            bytes.len()
+        }
+        _ => {
+            let mut cursor = start + 1;
+            while cursor < bytes.len() && (0x20..=0x2f).contains(&bytes[cursor]) {
+                cursor += 1;
+            }
+            (cursor + usize::from(cursor < bytes.len())).min(bytes.len())
+        }
+    }
+}
+
+fn is_sgr(bytes: &[u8], start: usize, end: usize) -> bool {
+    end >= start + 3
+        && bytes.get(start + 1) == Some(&b'[')
+        && bytes.get(end - 1) == Some(&b'm')
+        && bytes[start + 2..end - 1]
+            .iter()
+            .all(|byte| (0x30..=0x3f).contains(byte))
+}
+
+/// Removes terminal commands from untrusted display text while preserving SGR styling.
+fn sanitize_terminal_output(text: &str) -> std::borrow::Cow<'_, str> {
+    let bytes = text.as_bytes();
+    if !bytes.iter().any(|byte| {
+        *byte == b'\x1b' || (*byte < 0x20 && !matches!(*byte, b'\n' | b'\t')) || *byte == 0x7f
+    }) {
+        return std::borrow::Cow::Borrowed(text);
+    }
+
+    let mut sanitized = String::with_capacity(text.len());
+    let mut retained_start = 0;
+    let mut cursor = 0;
+    while cursor < bytes.len() {
+        if bytes[cursor] == b'\x1b' {
+            sanitized.push_str(&text[retained_start..cursor]);
+            let end = escape_sequence_end(bytes, cursor);
+            if is_sgr(bytes, cursor, end) {
+                sanitized.push_str(&text[cursor..end]);
+            }
+            cursor = end;
+            retained_start = cursor;
+            continue;
+        }
+
+        if (bytes[cursor] < 0x20 && !matches!(bytes[cursor], b'\n' | b'\t'))
+            || bytes[cursor] == 0x7f
+        {
+            sanitized.push_str(&text[retained_start..cursor]);
+            cursor += 1;
+            retained_start = cursor;
+            continue;
+        }
+
+        cursor += 1;
+    }
+    sanitized.push_str(&text[retained_start..]);
+    std::borrow::Cow::Owned(sanitized)
+}

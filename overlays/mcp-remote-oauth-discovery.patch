+func TestHandleUnauthorizedReplacesCachedCallback(t *testing.T) {
+	t.Parallel()
+	as := newASFixture(t)
+	opener := newFakeOpener()
+	cfg := &config.Config{
+		ServerURL:   "https://mcp.example/server",
+		ConfigDir:   t.TempDir(),
+		AuthTimeout: 5 * time.Second,
+	}
+	storage, err := NewStorage(cfg.ConfigDir, cfg.ServerURL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := storage.SaveClient(&ClientInfo{
+		ClientID:     "previous-client",
+		RedirectURIs: []string{"http://127.0.0.1:1/callback"},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	p := New(cfg, opener, logging.Discard())
+	done := make(chan error, 1)
+	go func() { done <- p.HandleUnauthorized(context.Background(), as.wwwAuthenticate()) }()
+	select {
+	case authURL := <-opener.openedURL:
+		runUserAgent(t, authURL)
+	case <-time.After(3 * time.Second):
+		t.Fatal("opener was never called")
+	}
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	as.mu.Lock()
+	defer as.mu.Unlock()
+	if as.dcrCalls != 1 {
+		t.Fatalf("DCR calls: got %d, want 1", as.dcrCalls)
+	}
+	client, err := storage.LoadClient()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if client.ClientID == "previous-client" {
+		t.Fatal("stale client was reused")
+	}
+}

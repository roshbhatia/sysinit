+func TestDiscoveryIssuerPath(t *testing.T) {
+	for _, path := range []string{"", "/mcp/launchdarkly", "/mcp/launchdarkly/", "/tenant%2Fname"} {
+		t.Run(path, func(t *testing.T) {
+			expected := wellKnownAS + strings.TrimRight(path, "/")
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.EscapedPath() != expected {
+					t.Errorf("metadata path = %q, want %q", r.URL.EscapedPath(), expected)
+					http.NotFound(w, r)
+					return
+				}
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.Write([]byte(`{"authorization_endpoint":"https://issuer/auth","token_endpoint":"https://issuer/token","registration_endpoint":"https://issuer/dcr"}`))
+			}))
+			defer server.Close()
+			meta, err := newTestProvider(t, nil).fetchAS(context.Background(), server.URL+path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if meta.RegistrationEndpoint != "https://issuer/dcr" {
+				t.Fatalf("registration endpoint = %q", meta.RegistrationEndpoint)
+			}
+		})
+	}
+}

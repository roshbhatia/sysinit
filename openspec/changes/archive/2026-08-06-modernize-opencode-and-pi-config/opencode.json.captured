{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "formatter": {
    "deadnix": {
      "command": [
        "/nix/store/nm9c6356ik8wym2azl5nhb0s4zjdb491-deadnix-1.3.1/bin/deadnix",
        "--edit",
        "$FILE"
      ],
      "extensions": [
        ".nix"
      ]
    }
  },
  "instructions": [
    "**/.cursorrules",
    "**/AGENTS.md",
    "**/CLAUDE.md",
    "**/CONSTITUTION.md",
    "**/CONTRIBUTING.md",
    "**/COPILOT.md",
    "**/docs/guidelines.md",
    ".cursor/rules",
    ".sysinit/lessons.md"
  ],
  "keybinds": {
    "leader": "ctrl+a"
  },
  "mcp": {
    "ast-grep": {
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/ast-grep/ast-grep-mcp",
        "ast-grep-server"
      ],
      "enabled": true,
      "type": "local"
    },
    "basic-memory": {
      "command": [
        "/nix/store/fwqs85k65vxlw0qsvi9yma8hrvij1dby-basic-memory-mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "playwright": {
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git * --no-gpg-sign*": "deny",
      "git * --no-verify*": "deny",
      "git branch * -D*": "deny",
      "git branch -D*": "deny",
      "git clean * -f*": "deny",
      "git clean -d*": "deny",
      "git clean -f*": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset * --hard*": "deny",
      "git reset --hard*": "deny"
    },
    "grep": "allow",
    "read": "allow",
    "skill": {
      "*": "allow"
    },
    "webfetch": "allow",
    "write": "allow"
  },
  "plugin": [
    "@bastiangx/opencode-unmoji",
    "opencode-gemini-auth",
    "opencode-handoff",
    "opencode-claude-memory",
    "opencode-plugin-openspec",
    "opencode-openai-codex-auth",
    "opencode-pty",
    "opencode-vibeguard",
    "@franlol/opencode-md-table-formatter"
  ],
  "provider": {
    "ollama": {
      "models": {
        "qwen2.5-coder:14b": {
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "name": "Qwen2.5-Coder 14B"
        },
        "qwen2.5-coder:7b": {
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "name": "Qwen2.5-Coder 7B"
        }
      },
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      }
    },
    "openai": {
      "models": {
        "gpt-5.3-codex": {
          "name": "GPT-5.3 Codex (ChatGPT)"
        },
        "gpt-5.4-mini": {
          "name": "GPT-5.4 Mini (ChatGPT)",
          "options": {
            "reasoningEffort": "low"
          }
        },
        "gpt-5.5": {
          "name": "GPT-5.5 (ChatGPT)"
        }
      },
      "options": {
        "include": [
          "reasoning.encrypted_content"
        ],
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "store": false,
        "textVerbosity": "medium"
      }
    }
  },
  "share": "disabled",
  "small_model": "openai/gpt-5.4-mini",
  "theme": "system",
  "tui": {
    "scroll_acceleration": {
      "enabled": true
    }
  },
  "lsp": {
    "nixd": {
      "command": [
        "/nix/store/kzd4cvzm5z2wnckg5zamp5lqm8rss4xp-nixd-2.9.2/bin/nixd"
      ],
      "extensions": [
        ".nix"
      ]
    }
  },
  "model": "openai/gpt-5.5"
}

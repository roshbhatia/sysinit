[[command prefix kind];
 ["gh pr list --limit 2" [gh pr list --json "number,title,url,state,isDraft,author,headRefName,baseRefName,updatedAt"] array]
 ["gh issue list --state open" [gh issue list --json "number,title,url,state,author,assignees,labels,updatedAt"] array]
 ["gh run list --limit 2" [gh run list --json "databaseId,workflowName,headBranch,status,conclusion,url,createdAt"] array]
 ["docker ps --all" [docker container ls --format] objects]
 ["docker images" [docker image ls --format] objects]
 ["docker container ls" [docker container ls --format] objects]
 ["docker image ls" [docker image ls --format] objects]
 ["docker inspect example" [docker inspect example] array]
 ["docker context ls" [docker context ls --format] objects]
 ["nix flake metadata ." [nix flake metadata --json] record]
 ["nix flake show ." [nix flake show --json] record]
 ["nix path-info ./result" [nix path-info --json] record]
 ["kubectl get pods" [kubectl get -o json pods] record]
 ["kubecolor get pods" [kubecolor get -o json pods] record]
 ["k get pods" [k get -o json pods] record]
 ["kubectl config view" [kubectl config view -o json] record]
 ["uv pip list" [uv pip list --format json] array]
 ["cargo metadata --no-deps" [cargo metadata --format-version "1"] record]
 ["pueue status status=running" [pueue status --json] record]
 ["colima list" [colima list --json] objects]
 ["atuin threads list" [atuin threads list --style json] array]
 ["atuin threads show latest" [atuin threads show --style json] record]
 ["atuin threads search fixture" [atuin threads search --style json] array]
 ["threads list" [atuin threads list --style json] array]
 ["threads show latest" [atuin threads show --style json] record]
 ["threads search fixture" [atuin threads search --style json] array]
]
